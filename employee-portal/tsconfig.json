{
  "extends": "../config/tsconfig.next.json",
  "compilerOptions": {
    "outDir": "./build/dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@eshg/lib-employee-portal/theme"]
  },
  "include": [
    "staticSvgImage.d.ts",
    "next.config.js",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "vitest.config.ts",
    "vitest-setup.ts",
    "eslint.config.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/env/*.js"
  ],
  "exclude": ["node_modules", "src/serviceWorker/sw"]
}
