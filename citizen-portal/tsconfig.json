{
  "extends": "../config/tsconfig.next.json",
  "compilerOptions": {
    "outDir": "./build/dist",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next.config.js",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/env/*.js"
  ],
  "exclude": ["node_modules"]
}
