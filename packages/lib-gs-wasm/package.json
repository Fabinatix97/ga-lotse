{
  "name": "@eshg/lib-gs-wasm",
  "version": "0.0.5",
  "description": "Ghostscript compiled to webassembly for webworkers",
  "type": "module",
  "files": [
    "build/dist/"
  ],
  "exports": {
    "./gs": {
      "types": ["./build/dist/gs.d.ts"],
      "import": "./build/dist/gs.js"
    }
  },
  "packageManager": "pnpm@10.23.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18 <23",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.21 <11",
      "onFail": "error"
    }
  }
}
