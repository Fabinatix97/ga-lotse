<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1731417781703-4">
    <dropForeignKeyConstraint baseTableName="statistic" constraintName="fk_statistic_abstract_aggregation_result"/>
    <dropForeignKeyConstraint baseTableName="report_series" constraintName="fk_report_series_statistic"/>

    <dropPrimaryKey tableName="statistic" constraintName="pk_statistic"/>
    <renameTable oldTableName="statistic" newTableName="evaluation"/>
    <addPrimaryKey tableName="evaluation" columnNames="id" constraintName="pk_evaluation"/>

    <dropIndex indexName="idx_report_series_statistic_id" tableName="report_series"/>
    <renameColumn tableName="report_series" oldColumnName="statistic_id" newColumnName="evaluation_id"/>
    <createIndex indexName="idx_report_series_evaluation_id" tableName="report_series">
      <column name="evaluation_id"/>
    </createIndex>

    <addForeignKeyConstraint baseColumnNames="id" baseTableName="evaluation" constraintName="fk_evaluation_abstract_aggregation_result" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="abstract_aggregation_result" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="evaluation_id" baseTableName="report_series" constraintName="fk_report_series_evaluation" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="evaluation" validate="true"/>

    <dropForeignKeyConstraint baseTableName="data_source" constraintName="fk_data_source_evaluation_template"/>
    <dropForeignKeyConstraint baseTableName="analysis_template" constraintName="fk_analysis_template_evaluation_template"/>
    <dropPrimaryKey tableName="evaluation_template" constraintName="pk_statistics_scheme"/>
    <addPrimaryKey tableName="evaluation_template" columnNames="id" constraintName="pk_evaluation_template"/>
    <addForeignKeyConstraint baseColumnNames="evaluation_template_id" baseTableName="data_source" constraintName="fk_data_source_evaluation_template" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="evaluation_template" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="evaluation_template_id" baseTableName="analysis_template" constraintName="fk_analysis_template_evaluation_template" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="evaluation_template" validate="true"/>
  </changeSet>
</databaseChangeLog>
