<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1720447354095-1">
    <createTable tableName="histogram_group_data">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_histogram_group_data"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="histogram_group_datas_order" type="INTEGER"/>
      <column name="histogram_bin_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="histogram_chart_data_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="count" type="INTEGER"/>
    </createTable>
    <addUniqueConstraint columnNames="histogram_bin_id" constraintName="histogram_group_data_histogram_bin_id_key" tableName="histogram_group_data"/>
    <addForeignKeyConstraint baseColumnNames="histogram_bin_id" baseTableName="histogram_group_data" constraintName="fk_histogram_group_data_histogram_bin" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="histogram_bin" validate="true"/>

    <createTable tableName="histogram_group_data_key_to_counts">
      <column name="histogram_group_data_id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_histogram_group_data_key_to_counts"/>
      </column>
      <column name="key_to_counts_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="key_to_counts_order" type="INTEGER">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_histogram_group_data_key_to_counts"/>
      </column>
    </createTable>
    <addUniqueConstraint columnNames="key_to_counts_id" constraintName="histogram_group_data_key_to_counts_key_to_counts_id_key" tableName="histogram_group_data_key_to_counts"/>
    <addForeignKeyConstraint baseColumnNames="histogram_group_data_id" baseTableName="histogram_group_data_key_to_counts" constraintName="fk_histogram_group_data_key_to_counts_histogram_group_data" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="histogram_group_data" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="key_to_counts_id" baseTableName="histogram_group_data_key_to_counts" constraintName="fk_histogram_group_data_key_to_counts_key_to_count" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="key_to_count" validate="true"/>

    <createTable tableName="histogram_chart_data">
      <column name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_histogram_chart_data"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseColumnNames="id" baseTableName="histogram_chart_data" constraintName="fk_histogram_chart_data_diagram_data" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="diagram_data" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="histogram_chart_data_id" baseTableName="histogram_group_data" constraintName="fk_histogram_group_data_histogram_chart_data" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="histogram_chart_data" validate="true"/>
