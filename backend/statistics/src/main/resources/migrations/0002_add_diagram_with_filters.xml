            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="id" baseTableName="value_option_filter_parameter" constraintName="fk_value_option_filter_parameter_abstract_filter_parameter" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="abstract_filter_parameter" validate="true"/>

        <createTable tableName="value_option_filter_to_search_values">
            <column name="id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="search_value" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="id" baseTableName="value_option_filter_to_search_values" constraintName="fk_value_option_filter_to_search_values_value_option_filter_parameter" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="value_option_filter_parameter" validate="true"/>

        <addNotNullConstraint columnDataType="clob" columnName="meaning" tableName="value_to_meaning" validate="true"/>
        <addNotNullConstraint columnDataType="clob" columnName="value" tableName="value_to_meaning" validate="true"/>
    </changeSet>
</databaseChangeLog>
