        <addForeignKeyConstraint baseColumnNames="scheme_id" baseTableName="data_source" constraintName="fk_data_source_statistics_scheme" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="statistics_scheme" validate="true"/>

