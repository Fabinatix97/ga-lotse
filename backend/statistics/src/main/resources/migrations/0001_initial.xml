        </createTable>

        <addUniqueConstraint columnNames="external_id" constraintName="statistics_scheme_external_id_key" tableName="statistics_scheme"/>

        <!-- data_source -->
        <createTable tableName="data_source">
            <column autoIncrement="true" name="id" type="BIGINT">
