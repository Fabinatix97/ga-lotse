<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1736846292079-1">
    <renameColumn tableName="appointment_block_group_consultants" oldColumnName="consultants" newColumnName="consultant_id"/>
    <renameColumn tableName="appointment_block_group_mfas" oldColumnName="mfas" newColumnName="mfa_id"/>
    <renameColumn tableName="appointment_block_group_physicians" oldColumnName="physicians" newColumnName="physician_id"/>

    <sql>delete from appointment_block_group_consultants where consultant_id is null</sql>
    <sql>delete from appointment_block_group_mfas where mfa_id is null</sql>
    <sql>delete from appointment_block_group_physicians where physician_id is null</sql>

    <addNotNullConstraint tableName="appointment_block_group_consultants" columnName="consultant_id" columnDataType="uuid"/>
    <addNotNullConstraint tableName="appointment_block_group_mfas" columnName="mfa_id" columnDataType="uuid"/>
    <addNotNullConstraint tableName="appointment_block_group_physicians" columnName="physician_id" columnDataType="uuid"/>
  </changeSet>
</databaseChangeLog>
