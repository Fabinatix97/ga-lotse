<#-- @ftlvariable name="departmentLogo" type="de.eshg.lib.document.generator.department.DepartmentLogo" -->
<#-- @ftlvariable name="departmentInfo" type="de.eshg.measlesprotection.pdf.coverletter.DepartmentInfo" -->
<#-- @ftlvariable name="addressee" type="de.eshg.measlesprotection.pdf.coverletter.CoverLetterPerson" -->
<#-- @ftlvariable name="body" type="de.eshg.measlesprotection.pdf.coverletter.CoverLetterBody" -->
<table class="header">
  <colgroup>
    <col style="width: 60%;"/>
    <col style="width: 40%;"/>
  </colgroup>
  <tr>
    <td valign="top"/>
    <td valign="top">
      <img src="data:${departmentLogo.contentType};base64,${departmentLogo.contentAsBase64}" width="250px" alt="logo"/>
    </td>
  </tr>
  <tr class="letterhead">
    <td valign="top" class="receiver">
      <div class="officeAddress">
      ${departmentInfo.street()} ${departmentInfo.houseNumber()}, ${departmentInfo.postalCode()} ${departmentInfo.city()}
      </div>
      <#if addressee.custodianClause??>
        <div>${addressee.custodianClause}</div>
      </#if>
      <div>${addressee.firstName} ${addressee.lastName}</div>
      <div>${addressee.street}</div>
      <div>${addressee.postalCode} ${addressee.city}</div>
    </td>
    <td valign="top" class="sender">
      <table>
        <tr>
          <td>
            <div class="officeInfoContent">${departmentInfo.name()}</div>
            <div class="officeInfoContent">${departmentInfo.street()} ${departmentInfo.houseNumber()}</div>
            <div class="officeInfoContent">${departmentInfo.postalCode()} ${departmentInfo.city()}</div>
            <br/>
          </td>
        </tr>
        <tr>
          <td>
            <div class="officeInfoHeader">E-Mail</div>
            <div class="officeInfoContent">${departmentInfo.email()}</div>
          </td>
        </tr>
        <tr>
          <td>
            <div class="officeInfoHeader">Datum</div>
            <div class="officeInfoContent">${body.dateString}</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
