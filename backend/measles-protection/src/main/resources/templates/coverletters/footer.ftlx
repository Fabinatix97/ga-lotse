<#-- @ftlvariable name="departmentInfo" type="de.eshg.measlesprotection.pdf.coverletter.DepartmentInfo" -->
<footer>
  <div class="footerContent">
    <div>
      Hausanschrift: ${departmentInfo.street()} ${departmentInfo.houseNumber()}, ${departmentInfo.postalCode()} ${departmentInfo.city()}
    </div>
    <div>
      Hotline: ${departmentInfo.phoneNumber()}. Internet:
      <a href="${departmentInfo.homepage()}">${departmentInfo.homepage()}</a>
    </div>
  </div>
</footer>
