<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1746197989561-1">
    <createTable tableName="oms_appointment_standard_duration">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true"
          primaryKeyName="pk_oms_appointment_standard_duration"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="initialized" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="official_medical_service_long" type="INTERVAL">
        <constraints nullable="false"/>
      </column>
      <column name="official_medical_service_short" type="INTERVAL">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <dropUniqueConstraint constraintName="appointment_type_config_appointment_type_key" tableName="appointment_type_config"/>
    <dropTable tableName="appointment_type_config"/>
  </changeSet>
</databaseChangeLog>
