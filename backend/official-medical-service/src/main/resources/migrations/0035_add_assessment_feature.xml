        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet author="GA-Lotse" id="1771939441708-6">
    <createTable tableName="oms_legal_basis">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_oms_legal_basis"/>
