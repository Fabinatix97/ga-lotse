      <column name="title" type="TEXT">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet author="GA-Lotse" id="1771939441708-8">
    <createTable tableName="medical_assessment">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_medical_assessment"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="external_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="assessment_result" type="ASSESSMENTRESULT"/>
      <column name="assessment_status" type="ASSESSMENTSTATUS">
        <constraints nullable="false"/>
      </column>
      <column name="assessment_type" type="ASSESSMENTTYPE">
        <constraints nullable="false"/>
      </column>
      <column name="document_cache" type="TEXT"/>
      <column name="document_content" type="TEXT"/>
      <column name="created" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="editor" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="finished" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="summary" type="TEXT"/>
      <column name="title" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="procedure_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="recipient_type" type="RECIPIENTTYPE"/>
    </createTable>
  </changeSet>
