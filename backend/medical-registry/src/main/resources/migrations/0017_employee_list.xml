<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="GA-Lotse" id="1747058403397-14">
        <sql>
            truncate table
                partial_medical_registry_entry_change,
                full_medical_registry_entry_change,
                medical_registry_entry,
                medical_registry_procedure,
                file,
                default_revision_entity,
                approval_request,
                file_deletion_approval_request,
                manual_progress_entry_deletion_approval_request,
                manual_progress_entry_deletion_approval_request_notification,
                file_content,
                profession_information cascade;
        </sql>

        <dropForeignKeyConstraint baseTableName="professional" constraintName="fk_professional_medical_registry_procedure"/>
        <dropUniqueConstraint constraintName="professional_central_file_state_id_key" tableName="professional"/>
        <dropUniqueConstraint constraintName="professional_external_id_key" tableName="professional"/>
        <dropColumn columnName="central_file_state_id" tableName="professional"/>
        <dropColumn columnName="external_id" tableName="professional"/>
        <dropColumn columnName="person_type" tableName="professional"/>
        <dropColumn columnName="procedure_id" tableName="professional"/>
        <dropColumn columnName="version" tableName="professional"/>
        <dropSequence sequenceName="professional_seq"/>

        <ext:createPostgresEnumType name="employeechangetype" values="ADD, REMOVE"/>
        <createTable tableName="person">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_person"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="central_file_state_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="person_type" type="PERSONTYPE">
                <constraints nullable="false"/>
            </column>
            <column name="procedure_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint columnNames="central_file_state_id" constraintName="person_central_file_state_id_key" tableName="person"/>
        <addUniqueConstraint columnNames="external_id" constraintName="person_external_id_key" tableName="person"/>

        <createSequence cacheSize="1" cycle="false" dataType="bigint" incrementBy="50" maxValue="9223372036854775807" minValue="1" sequenceName="person_seq" startValue="1"/>

        <createTable tableName="employee_change">
            <column name="employee_change_type" type="EMPLOYEECHANGETYPE">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_employee_change"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="id" baseTableName="employee_change" constraintName="fk_employee_change_person" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="person" validate="true"/>

        <createTable tableName="employee">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_employee"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="id" baseTableName="employee" constraintName="fk_employee_person" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="person" validate="true"/>

        <addForeignKeyConstraint baseColumnNames="id" baseTableName="professional" constraintName="fk_professional_person" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="person" validate="true"/>

        <addForeignKeyConstraint baseColumnNames="procedure_id" baseTableName="person" constraintName="fk_person_medical_registry_procedure" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="medical_registry_procedure" validate="true"/>
        <createIndex indexName="idx_person_procedure_id" tableName="person">
            <column name="procedure_id"/>
        </createIndex>

        <ext:addPostgresEnumValues enumTypeName="typeofpartialmedicalregistryentrychange" valuesToAdd="CHANGE_OF_EMPLOYEES"/>
        <ext:addPostgresEnumValues enumTypeName="persontype" valuesToAdd="EMPLOYEE"/>
    </changeSet>
</databaseChangeLog>
