    <addForeignKeyConstraint baseColumnNames="information_statement_id" baseTableName="element" constraintName="fk_element_information_statement_template" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="information_statement_template" validate="true"/>
