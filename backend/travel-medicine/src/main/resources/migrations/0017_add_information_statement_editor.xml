      <column name="element_type" type="VARCHAR(31)">
        <constraints nullable="false"/>
      </column>
      <column name="id" type="UUID">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_element"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="deletable" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="editable" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="moveable" type="BOOLEAN">
