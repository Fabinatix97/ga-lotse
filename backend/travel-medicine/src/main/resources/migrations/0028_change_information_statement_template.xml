<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1727439268021-2">
    <dropForeignKeyConstraint baseTableName="element"
                              constraintName="fk_element_information_statement_template"/>
  </changeSet>
  <changeSet author="GA-Lotse" id="1727439268021-1">
    <addColumn tableName="information_statement_template">
      <column name="content" type="text">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
  <changeSet author="GA-Lotse" id="1727439268021-3">
    <dropTable tableName="element"/>
  </changeSet>
  <changeSet author="GA-Lotse" id="1727439268021-4">
    <dropTable tableName="text_block"/>
  </changeSet>
</databaseChangeLog>
