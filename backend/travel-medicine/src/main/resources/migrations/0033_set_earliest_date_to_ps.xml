<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="set-earliest-date" author="GA-Lotse">

    <sql>
        UPDATE procedure_step ps
        set earliest_date=now()
        where earliest_date is null
          and is_follow_up = true
          and 'CITIZEN_PORTAL' = (SELECT created_by
                                  from vaccination_consultation
                                  where id = ps.vaccination_consultation_id)
    </sql>
  </changeSet>
</databaseChangeLog>
