<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1770710882344-1">
    <addColumn tableName="appointment_block">
      <column name="available_for_citizen" type="BOOLEAN"/>
    </addColumn>
    <addColumn tableName="appointment_block">
      <column name="available_for_bulk_booking" type="BOOLEAN"/>
    </addColumn>
    <sql>
      update appointment_block
      set available_for_citizen = (select abg.available_for_citizen
                                   from appointment_block_group abg
                                   where abg.id =
                                         appointment_block.appointment_block_group_id);
    </sql>
    <sql>
      update appointment_block
      set available_for_bulk_booking = (select abg.available_for_bulk_booking
                                        from appointment_block_group abg
                                        where abg.id =
                                              appointment_block.appointment_block_group_id);
    </sql>
    <dropColumn columnName="available_for_bulk_booking"
                tableName="appointment_block_group"/>
    <dropColumn columnName="available_for_citizen"
                tableName="appointment_block_group"/>
  </changeSet>
</databaseChangeLog>
