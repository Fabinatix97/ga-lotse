  "components" : {
    "schemas" : {
      "AddBarrierTestHelperResponse" : {
        "required" : [ "barrierId" ],
        "type" : "object",
        "properties" : {
          "barrierId" : {
            "minimum" : 1,
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "Appointment" : {
        "required" : [ "end", "start" ],
        "type" : "object",
        "properties" : {
          "end" : {
            "type" : "string",
            "format" : "date-time"
          },
          "start" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "description" : "Appointment of a procedure."
      },
      "AppointmentBlock" : {
        "required" : [ "appointmentBlockBins", "bookedAppointments", "consultants", "end", "id", "mfas", "parallelExaminations", "physicians", "resolvedUsers", "start", "types" ],
        "type" : "object",
        "properties" : {
          "appointmentBlockBins" : {
            "maxItems" : 10,
            "minItems" : 1,
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AppointmentBlockBin"
            }
          },
          "availableForBulkBooking" : {
            "type" : "boolean"
          },
          "availableForCitizen" : {
            "type" : "boolean"
          },
          "bookedAppointments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Appointment"
            }
          },
          "consultants" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "creatorId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "end" : {
            "type" : "string",
            "description" : "Time at which the appointment block ends.",
            "format" : "date-time",
            "example" : "2016-01-01T01:45:00.123456+01:00"
          },
          "id" : {
            "type" : "string",
            "description" : "Id of the AppointmentBlock.",
            "format" : "uuid",
            "example" : "UUID_1"
          },
          "mfas" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "parallelExaminations" : {
            "maximum" : 10,
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32"
          },
          "physicians" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "resolvedUsers" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/AppointmentBlockUser"
            }
          },
          "room" : {
            "type" : "string"
          },
          "start" : {
            "type" : "string",
            "description" : "Time at which the appointment block starts.",
            "format" : "date-time",
            "example" : "2016-01-01T01:00:00.123456+01:00"
          },
          "types" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AppointmentType"
            }
          }
        }
      },
      "AppointmentBlockBin" : {
        "required" : [ "appointmentBlockSlots" ],
        "type" : "object",
        "properties" : {
          "appointmentBlockSlots" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AppointmentBlockSlot"
            }
          }
        },
        "description" : "A bin represents a single sequence of slots in an appointment block, meaning there are no parallel slots within a bin. Multiple bins can occur within a block."
      },
      "AppointmentBlockDefaultAvailabilityFlags" : {
        "required" : [ "availableForBulkBooking", "availableForCitizen" ],
        "type" : "object",
        "properties" : {
          "availableForBulkBooking" : {
            "type" : "boolean"
          },
          "availableForCitizen" : {
            "type" : "boolean"
          }
        },
        "description" : "Default availability flags for the appointment block creation UI"
      },
      "AppointmentBlockSlot" : {
        "required" : [ "booked", "end", "start" ],
        "type" : "object",
        "properties" : {
          "appointmentId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "appointmentType" : {
            "$ref" : "#/components/schemas/AppointmentType"
          },
          "booked" : {
            "type" : "boolean"
          },
          "end" : {
            "type" : "string",
            "format" : "date-time"
          },
          "information" : {
            "type" : "string"
          },
          "procedureId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "start" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "description" : "A free time slot or a booked appointment"
      },
      "AppointmentBlockSortKey" : {
        "type" : "string",
        "enum" : [ "START", "END" ]
      },
      "AppointmentBlockUser" : {
        "required" : [ "firstName", "lastName", "userId" ],
        "type" : "object",
        "properties" : {
          "firstName" : {
            "type" : "string",
            "description" : "The given name(s) of a user.",
            "example" : "John"
          },
          "lastName" : {
            "type" : "string",
            "description" : "The last name of a user.",
            "example" : "Doe"
          },
          "userId" : {
            "type" : "string",
            "description" : "The Id of the user.",
            "format" : "uuid",
            "example" : "UUID_2"
          }
        }
      },
      "AppointmentLocation" : {
        "required" : [ "id", "name" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "minLength" : 1,
            "type" : "string"
          }
        }
      },
      "AppointmentType" : {
        "type" : "string",
        "enum" : [ "CONSULTATION", "VACCINATION", "REGULAR_EXAMINATION", "CAN_CHILD", "ENTRY_LEVEL", "SPECIAL_NEEDS", "PROOF_SUBMISSION", "HIV_STI_CONSULTATION", "SEX_WORK", "RESULTS_REVIEW", "OFFICIAL_MEDICAL_SERVICE_SHORT", "OFFICIAL_MEDICAL_SERVICE_LONG", "MEDS_ABROAD_CERTIFICATION", "PROSTITUTE_PROTECTION_CONSULTATION" ]
      },
      "ConfigurationStatus" : {
        "type" : "string",
        "enum" : [ "COMPLETE", "PARTIALLY_COMPLETE", "INCOMPLETE" ]
      },
      "CreateAppointmentBlockGroupResponse" : {
        "required" : [ "appointmentBlockIds", "id" ],
        "type" : "object",
        "properties" : {
          "appointmentBlockIds" : {
            "minItems" : 1,
            "type" : "array",
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "id" : {
