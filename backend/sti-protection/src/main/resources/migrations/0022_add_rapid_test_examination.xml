<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1732033780185-1">
    <createTable tableName="rapid_test_examination">
      <column name="general_comments" type="text"/>
      <column name="tests_payed" type="bool">
        <constraints nullable="false"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="blood_pressure_data" type="TEXT"/>
      <column name="blood_pressure_requested" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="hiv_number" type="TEXT"/>
      <column name="hiv_result" type="BOOLEAN"/>
      <column name="hiv_requested" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="pregnancy_test_number" type="TEXT"/>
      <column name="pregnancy_test_result" type="BOOLEAN"/>
      <column name="pregnancy_test_requested" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="pulse_data" type="TEXT"/>
      <column name="pulse_requested" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="syphillis_number" type="TEXT"/>
      <column name="syphillis_result" type="BOOLEAN"/>
      <column name="syphilis_requested" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="ultrasound_data" type="TEXT"/>
      <column name="ultrasound_requested" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="urinalysis_data" type="TEXT"/>
      <column name="urinalysis_requested" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="procedure_id" type="BIGINT">
        <constraints nullable="false" primaryKey="true"
                     primaryKeyName="pk_rapid_test_examination"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet author="GA-Lotse" id="1732033780185-2">
    <addForeignKeyConstraint baseColumnNames="procedure_id"
                             baseTableName="rapid_test_examination"
                             constraintName="fk_rapid_test_examination_sti_protection_procedure"
                             deferrable="false" initiallyDeferred="false"
                             onDelete="NO ACTION" onUpdate="NO ACTION"
                             referencedColumnNames="id"
                             referencedTableName="sti_protection_procedure"
                             validate="true"/>
  </changeSet>
</databaseChangeLog>
