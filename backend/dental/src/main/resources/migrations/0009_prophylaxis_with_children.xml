<databaseChangeLog xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet author="GA-Lotse" id="1732789348671-1">
    <dropTable tableName="child_examinations"/>
    <sql>TRUNCATE TABLE examination, prophylaxis_session</sql>

    <dropColumn tableName="examination" columnName="examination_date" />

    <addColumn tableName="prophylaxis_session">
      <column name="group_name" type="TEXT">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <addColumn tableName="examination">
      <column name="child_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="prophylaxis_session_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <addUniqueConstraint tableName="examination" columnNames="child_id, prophylaxis_session_id" constraintName="examination_child_id_prophylaxis_session_id_key"/>

    <addForeignKeyConstraint baseTableName="examination" baseColumnNames="child_id"
                             constraintName="fk_examination_child"
                             referencedTableName="child" referencedColumnNames="id"/>

    <addForeignKeyConstraint baseTableName="examination" baseColumnNames="prophylaxis_session_id"
                             constraintName="fk_examination_prophylaxis_session"
                             referencedColumnNames="id" referencedTableName="prophylaxis_session"/>

    <createIndex indexName="idx_examination_prophylaxis_session_id" tableName="examination">
      <column name="prophylaxis_session_id"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
