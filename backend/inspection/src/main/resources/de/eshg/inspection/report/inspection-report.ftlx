<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html
  PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN"
  "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<#-- @ftlvariable name="departmentLogo" type="de.eshg.lib.document.generator.department.DepartmentLogo" -->
<#-- @ftlvariable name="office" type="de.eshg.inspection.report.pdf.RepAddress" -->
<#-- @ftlvariable name="facility" type="de.eshg.inspection.report.pdf.RepFacility" -->
<#-- @ftlvariable name="inspection" type="de.eshg.inspection.report.pdf.RepInspection" -->
<#-- @ftlvariable name="reportInfo" type="de.eshg.inspection.report.pdf.RepInfo" -->
<#-- @ftlvariable name="assignee" type="de.eshg.inspection.report.pdf.RepAssignee" -->

<html xml:lang="de" lang="de">
  <head>
    <link rel="stylesheet" type="text/css" href="inspection-report.css"/>
  </head>

  <body>
    <!-- note: footer (and header) must be specified *before* all other content, not after! -->
  <#include "header-table.ftlx">
  <#include "footer.ftlx">
  <#include "divider.ftlx">

    <div class="main">
    <#list inspection.content.elements as elem>
      <!-- note: we use #if/elseif instead of #switch because #switch is not recommended -->
      <!-- see https://freemarker.apache.org/docs/ref_directive_switch.html#autoid_125 -->
      <!-- and #if/elseif is more compact -->
      <#if elem.type == 'TOP_LEVEL_TITLE'>
        <h1>${elem.title}</h1>
      <#elseif elem.type == 'CHAPTER'>
        <h2>${elem.title}</h2>
      <#elseif elem.type == 'SECTION'>
        <h3>${elem.title}</h3>
      <#else>
        <div class="elementPairs">
          <#if elem.type == 'TEXT'>
            <p class="elementValue elementText">${(elem.value)!""}</p>
          <#elseif elem.type == 'TEXT_BLOCK' || elem.type == 'FULL_TEXT_BLOCK'>
            <#if elem.type == 'TEXT_BLOCK' && elem.title?starts_with("Beteiligte Personen")>
              <table class="generalInfo">
                <colgroup>
                  <col style="width: fit-content"/>
                  <col style="width: stretch"/>
                </colgroup>
                <tr valign="top">
                  <td class="elementTitle">
                    <p>${(elem.title)!""}:</p>
                  </td>
                  <td class="participants">
                    <#list elem.value?split("\n") as val>
                      <p class="elementValue">${(val)!""}</p>
                    </#list>
                  </td>
                </tr>
              </table>
            <#elseif elem.type == 'TEXT_BLOCK' && elem.title?starts_with("Datum")>
              <div class="generalInfo">
                <p class="elementTitle">${(elem.title)!""}: <span class="elementValue">${(elem.value)!""}</span></p>
              </div>
            <#elseif elem.type == 'TEXT_BLOCK' && elem.title?starts_with("Rechtsgrundlage")>
              <div class="generalInfo legalBasis">
                <p class="elementTitle">${(elem.title)!""}:</p>
                <p class="elementValue">${(elem.value)!""}</p>
              </div>
            <#else>
              <div class="no-page-break">
                <p class="elementTitle">${(elem.title)!""}</p>
                <p class="elementValue textBlock">${(elem.value)!""}</p>
              </div>
            </#if>
          <#elseif  elem.type == 'CHOICE'>
            <div class="choice">
              <#macro checkbox selected text>
                <#assign box>
                  <#if selected>
                    <img src="CheckboxCheckedIcon.svg" alt="checkbox checked"/>
                  <#else>
                    <img src="CheckboxUncheckedIcon.svg" alt="checkbox unchecked"></img>
                  </#if>
                </#assign>
                <div class="checkboxes no-page-break">
                  ${box}
                  <span class="label">${text}</span>
                </div>
              </#macro>
              <div class="no-page-break">
                <#if elem.simpleYesNo>
                  <table class="simpleYesNo">
                    <colgroup>
                      <col style="width: 70%"/>
                      <col style="width: 30%"/>
                    </colgroup>
                    <tr valign="top">
                      <td class="elementTitle">${elem.title}</td>
                      <td>
                        <div class="elementValue">
                          <#list elem.choices as choice>
                            <@checkbox selected=choice.selected text=choice.text?cap_first/>
                          </#list>
                        </div>
                      </td>
                    </tr>
                  </table>
                <#else>
                  <div style="no-page-break">
                    <p class="elementTitle">${elem.title}</p>
                    <p class="elementValue">
                      <#list elem.choices as choice>
                        <#if choice.text?starts_with("ja") || choice.text?starts_with("nein")>
                          <@checkbox selected=choice.selected text=choice.text?cap_first/>
                        <#else>
                          <@checkbox selected=choice.selected text=choice.text/>
                        </#if>
                        <#if elem.choiceWithExtraText>
                          <#if (choice.extraText)?has_content>
                            <p class="checkboxes extraText">${choice.extraText}</p>
                          </#if>
                        </#if>
                      </#list>
                    </p>
                  </div>
                </#if>
              </div>
            </div>
          </#if>
        </div>
      </#if>
    </#list>
      <div class="no-page-break greetingEnd">
        <p>Im Auftrag</p>
        <p>${assignee.fullName}</p>
      </div>
    </div>
  </body>
</html>
