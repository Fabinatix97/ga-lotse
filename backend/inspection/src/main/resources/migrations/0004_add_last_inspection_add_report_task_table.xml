<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1719910561452-1">
    <addColumn tableName="facility">
      <column name="last_inspected" type="TIMESTAMP WITH TIME ZONE"/>
    </addColumn>
  </changeSet>
  <changeSet author="GA-Lotse" id="1719910561452-2">
    <createTable tableName="inspection_report_task">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true"
                     primaryKeyName="pk_inspection_report_task"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet author="GA-Lotse" id="1719910561452-3">
    <addColumn tableName="inspection">
      <column name="followup_date" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="followup_type" type="TEXT"/>
    </addColumn>
    <update tableName="inspection">
      <column name="followup_date" valueComputed="(select inspection_execution_task.followup_date from inspection_execution_task INNER JOIN inspection_task ON inspection_task.id=inspection_execution_task.id where inspection_task.procedure_id=inspection.id)"/>
      <column name="followup_type" valueComputed="(select inspection_execution_task.followup_type from inspection_execution_task INNER JOIN inspection_task ON inspection_task.id=inspection_execution_task.id where inspection_task.procedure_id=inspection.id)"/>
    </update>
    <dropColumn tableName="inspection_execution_task">
      <column name="followup_date"/>
      <column name="followup_type"/>
    </dropColumn>
  </changeSet>
  <changeSet author="GA-Lotse" id="1720134708030-1">
    <addForeignKeyConstraint baseColumnNames="id" baseTableName="inspection_report_task" constraintName="fk_inspection_report_task_inspection_task" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="inspection_task" validate="true"/>
  </changeSet>
</databaseChangeLog>
