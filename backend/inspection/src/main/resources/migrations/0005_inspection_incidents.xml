<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="GA-Lotse" id="1719842382064-1">
        <createTable tableName="inspection_incident">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_inspection_incident"/>
            </column>
            <column name="incident_external_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="checklist_element_id" type="UUID"/>
            <column name="inspection_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="checklist_number" type="INTEGER"/>
            <column name="section_number" type="INTEGER"/>
            <column name="element_number" type="INTEGER"/>
            <column name="manual_position" type="INTEGER"/>
        </createTable>

        <addColumn tableName="checklist_element">
            <column name="inspection_incident_id" type="BIGINT"/>
        </addColumn>

        <addUniqueConstraint columnNames="checklist_element_id"
                             constraintName="inspection_incident_checklist_element_id_key"
                             tableName="inspection_incident"/>
        <addUniqueConstraint columnNames="inspection_incident_id"
                             constraintName="checklist_element_inspection_incident_id_key"
                             tableName="checklist_element"/>
        <addUniqueConstraint columnNames="incident_external_id" constraintName="inspection_incident_external_id_key"
                             tableName="inspection_incident"/>

        <addForeignKeyConstraint baseColumnNames="inspection_incident_id" baseTableName="checklist_element"
                                 constraintName="fk_checklist_element_inspection_incident" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="inspection_incident" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="checklist_element_id" baseTableName="inspection_incident"
                                 constraintName="fk_inspection_incident_checklist_element" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="checklist_element" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="inspection_id" baseTableName="inspection_incident"
                                 constraintName="fk_inspection_incident_inspection" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="inspection" validate="true"/>

    </changeSet>

    <changeSet author="GA-Lotse" id="1719842382064-2">
        <dropColumn columnName="is_incident" tableName="checklist_element"/>
    </changeSet>
</databaseChangeLog>