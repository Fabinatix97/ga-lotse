<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="1730973613540-2" author="GA-Lotse">

    <!--
    Data was inadvertently stored within a wrapping JSON object.
    Extract the inner json string, unescape it and cast, i.e. parse it to a jsonb object.
    -->

    <sql>
      UPDATE versioned_entry_content
      SET content_json = (content_json ->> 'jsonContent')::jsonb
      WHERE content_json IS NOT NULL;
    </sql>

  </changeSet>
</databaseChangeLog>
