{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "This is the api for Central Repository",
    "title" : "Central Repository Api",
    "version" : "0.1"
  },
  "servers" : [ {
    "url" : "http://localhost:8091"
  } ],
  "paths" : {
