<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1762875155045-1">
    <ext:createPostgresEnumType name="appointmenttype" values="CAN_CHILD, CONSULTATION, ENTRY_LEVEL, HIV_STI_CONSULTATION, MEDS_ABROAD_CERTIFICATION, OFFICIAL_MEDICAL_SERVICE_LONG, OFFICIAL_MEDICAL_SERVICE_SHORT, PROOF_SUBMISSION, PROSTITUTE_PROTECTION_CONSULTATION, REGULAR_EXAMINATION, RESULTS_REVIEW, SEX_WORK, SPECIAL_NEEDS, VACCINATION"/>
    <createTable tableName="appointment_block">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="external_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="appointment_block_end" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="appointment_block_start" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="calendar_event_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="parallel_examinations" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="appointment_block_group_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
        <column name="room" type="TEXT"/>
    </createTable>
    <createTable tableName="appointment_block_group">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_group"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="external_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="available_for_bulk_booking" type="BOOLEAN"/>
      <column name="available_for_citizen" type="BOOLEAN"/>
      <column name="creator_id" type="UUID"/>
      <column name="location_id" type="UUID"/>
    </createTable>
    <createTable tableName="appointment">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="appointment_end" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="appointment_start" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="type" type="APPOINTMENTTYPE">
        <constraints nullable="false"/>
      </column>
      <column name="appointment_block_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createTable tableName="appointment_type_holder">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_type_holder"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="slot_duration" type="INTERVAL">
        <constraints nullable="false"/>
      </column>
      <column name="type" type="APPOINTMENTTYPE">
        <constraints nullable="false"/>
      </column>
      <column name="appointment_block_group_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addUniqueConstraint columnNames="calendar_event_id" constraintName="appointment_block_calendar_event_id_key" tableName="appointment_block"/>
    <addUniqueConstraint columnNames="external_id" constraintName="appointment_block_external_id_key" tableName="appointment_block"/>
    <addUniqueConstraint columnNames="external_id" constraintName="appointment_block_group_external_id_key" tableName="appointment_block_group"/>
    <createTable tableName="appointment_block_availability_config">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_availability_config"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="available_for_bulk_booking" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="available_for_citizen" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="bulk_create_appointments_min_lead_time" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="citizen_free_appointments_max_lead_time" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="citizen_free_appointments_min_lead_time" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="initialized" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createTable tableName="appointment_block_consultants">
      <column name="appointment_block_id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_consultants"/>
      </column>
      <column name="consultant_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="consultants_order" type="INTEGER">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_consultants"/>
      </column>
    </createTable>
    <createTable tableName="appointment_block_mfas">
      <column name="appointment_block_id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_mfas"/>
      </column>
      <column name="mfa_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="mfas_order" type="INTEGER">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_mfas"/>
      </column>
    </createTable>
    <createTable tableName="appointment_block_physicians">
      <column name="appointment_block_id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_physicians"/>
      </column>
      <column name="physician_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="physicians_order" type="INTEGER">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_appointment_block_physicians"/>
      </column>
    </createTable>
    <createIndex indexName="idx_appointment_block_room" tableName="appointment_block">
      <column name="room"/>
    </createIndex>
    <createIndex indexName="idx_appointment_appointment_block_id" tableName="appointment">
      <column name="appointment_block_id"/>
    </createIndex>
    <createIndex indexName="idx_appointment_block_appointment_block_group_id" tableName="appointment_block">
      <column name="appointment_block_group_id"/>
    </createIndex>
    <createIndex indexName="idx_appointment_type_holder_appointment_block_group_id" tableName="appointment_type_holder">
      <column name="appointment_block_group_id"/>
    </createIndex>
    <addForeignKeyConstraint baseColumnNames="appointment_block_id" baseTableName="appointment" constraintName="fk_appointment_appointment_block" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="appointment_block" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="appointment_block_group_id" baseTableName="appointment_block" constraintName="fk_appointment_block_appointment_block_group" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="appointment_block_group" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="appointment_block_id" baseTableName="appointment_block_consultants" constraintName="fk_appointment_block_consultants_appointment_block" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="appointment_block" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="appointment_block_id" baseTableName="appointment_block_mfas" constraintName="fk_appointment_block_mfas_appointment_block" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="appointment_block" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="appointment_block_id" baseTableName="appointment_block_physicians" constraintName="fk_appointment_block_physicians_appointment_block" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="appointment_block" validate="true"/>
    <addForeignKeyConstraint baseColumnNames="appointment_block_group_id" baseTableName="appointment_type_holder" constraintName="fk_appointment_type_holder_appointment_block_group" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="appointment_block_group" validate="true"/>
  </changeSet>
</databaseChangeLog>
