  <changeSet author="GA-Lotse" id="1727090520141-2">
    <ext:createPostgresEnumType name="booleanwithunknown"
                                values="FALSE, TRUE, UNKNOWN"/>
    <addColumn tableName="vaccination_status">
      <column name="perkombi_hbv_new" type="booleanwithunknown"/>
    </addColumn>
    <update tableName="vaccination_status">
      <column name="perkombi_hbv_new"
              valueComputed="CAST(CASE WHEN perkombi_hbv THEN 'TRUE' ELSE 'FALSE' END AS booleanwithunknown)"/>
    </update>
    <dropColumn tableName="vaccination_status" columnName="perkombi_hbv"/>
    <renameColumn tableName="vaccination_status"
                  oldColumnName="perkombi_hbv_new"
                  newColumnName="perkombi_hbv"/>
  </changeSet>
