<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1772525031018-1">
    <ext:createPostgresEnumType name="userflowtype" values="ANAMNESIS, BOOKING, CANCELING, INFORMATION_STATEMENT, REPORTING, RESCHEDULING"/>
  </changeSet>
  <changeSet author="GA-Lotse" id="1772525031018-2">
    <createTable tableName="user_flow">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_flow"/>
      </column>
      <column name="version" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="external_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="user_flow_type" type="USERFLOWTYPE">
        <constraints nullable="false"/>
      </column>
      <column name="flow_start" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="flow_end" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <addUniqueConstraint columnNames="external_id" constraintName="user_flow_external_id_key" tableName="user_flow"/>
  </changeSet>
</databaseChangeLog>
