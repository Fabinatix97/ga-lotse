  <changeSet author="GA-Lotse" id="1741176449621-2">
    <createTable tableName="privacy_documents">
      <column autoIncrement="true" name="id" type="BIGINT">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_privacy_documents"/>
      </column>
      <column name="version" type="BIGINT">
