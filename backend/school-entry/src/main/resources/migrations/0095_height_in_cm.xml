<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet author="GA-Lotse" id="1748424784899-1">
    <addColumn tableName="development_screening">
      <column name="height_in_cm" type="INTEGER"/>
    </addColumn>

    <update tableName="development_screening">
      <column name="height_in_cm" valueComputed="CASE WHEN FLOOR(height * 100 + 0.5) > 900 THEN 999 ELSE FLOOR(height * 100 + 0.5) END"/>
    </update>

    <dropColumn tableName="development_screening" columnName="height"/>

    <renameColumn tableName="development_screening" oldColumnName="height_in_cm" newColumnName="height"/>
  </changeSet>
</databaseChangeLog>
