{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "This is the api for Local Service Directory",
    "title" : "Local Service Directory Api",
    "version" : "0.1"
  },
  "servers" : [ {
    "url" : "http://localhost:8089"
  } ],
  "paths" : {
    "/actor/announce" : {
      "put" : {
        "description" : "Only after an actor was provided with a valid certificate, the requirements to communicate with other actors are fulfilled.",
        "operationId" : "announceActor",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AnnounceRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Returns the announced actor"
          }
        },
        "summary" : "Announce an actor by updating its certificate",
        "tags" : [ "LsdActor" ]
      }
    },
    "/actor/heartbeat" : {
      "post" : {
        "operationId" : "heartbeat",
        "parameters" : [ {
          "in" : "query",
          "name" : "location",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Returns the announced actor"
          }
        },
        "summary" : "Inform LSD that actor is still alive",
        "tags" : [ "LsdActor" ]
      }
    },
    "/orgUnit/name" : {
      "get" : {
        "operationId" : "getName",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "Returns the name of the orgUnit"
          }
        },
        "summary" : "Get the name of the orgUnit",
        "tags" : [ "LsdOrgUnit" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ActorType" : {
        "type" : "string",
        "enum" : [ "EXT", "GM", "FM", "LSD", "MISC", "RESTRICTED", "WEB", "ZA", "ZR" ]
      },
      "AnnounceRequest" : {
        "required" : [ "certificate", "readableName", "type" ],
        "type" : "object",
        "properties" : {
          "certificate" : {
            "minLength" : 1,
            "type" : "string"
          },
          "readableName" : {
            "minLength" : 1,
            "type" : "string"
          },
          "type" : {
            "$ref" : "#/components/schemas/ActorType"
          }
        }
      }
    }
  }
}
