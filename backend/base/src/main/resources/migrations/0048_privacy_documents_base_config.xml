<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="GA-Lotse" id="1741796575564-1">
        <dropForeignKeyConstraint baseTableName="privacy_documents" constraintName="fk_privacy_notice"/>
        <dropForeignKeyConstraint baseTableName="privacy_documents" constraintName="fk_privacy_policy"/>

        <delete tableName="document"/>

        <dropUniqueConstraint constraintName="privacy_documents_privacy_notice_id_key" tableName="privacy_documents"/>
        <dropUniqueConstraint constraintName="privacy_documents_privacy_policy_id_key" tableName="privacy_documents"/>

        <dropTable tableName="privacy_documents"/>

        <addNotNullConstraint columnDataType="bytea" columnName="content" tableName="document" validate="true"/>

        <createTable tableName="privacy_document">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_privacy_document"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="de_file_size_bytes" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="en_file_size_bytes" type="INTEGER"/>
            <column name="de_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="en_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="de_id" baseTableName="privacy_document" constraintName="fk_privacy_document_de" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="document" validate="true"/>
        <addUniqueConstraint columnNames="de_id" constraintName="privacy_document_de_id_key" tableName="privacy_document"/>
        <addForeignKeyConstraint baseColumnNames="en_id" baseTableName="privacy_document" constraintName="fk_privacy_document_en" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="document" validate="true"/>
        <addUniqueConstraint columnNames="en_id" constraintName="privacy_document_en_id_key" tableName="privacy_document"/>

        <createTable tableName="privacy_documents_config">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_privacy_documents_config"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="privacy_notice_id" type="BIGINT"/>
            <column name="privacy_policy_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="privacy_notice_id" baseTableName="privacy_documents_config" constraintName="fk_privacy_documents_config_privacy_document_privacy_notice" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="privacy_document" validate="true"/>
        <addUniqueConstraint columnNames="privacy_notice_id" constraintName="privacy_documents_config_privacy_notice_id_key" tableName="privacy_documents_config"/>
        <addForeignKeyConstraint baseColumnNames="privacy_policy_id" baseTableName="privacy_documents_config" constraintName="fk_privacy_documents_config_privacy_document_privacy_policy" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="privacy_document" validate="true"/>
        <addUniqueConstraint columnNames="privacy_policy_id" constraintName="privacy_documents_config_privacy_policy_id_key" tableName="privacy_documents_config"/>

        <createTable tableName="base_privacy_documents_config">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_base_privacy_documents_config"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="privacy_notice_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="privacy_policy_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="privacy_notice_id" baseTableName="base_privacy_documents_config" constraintName="fk_base_privacy_documents_config_privacy_document_privacy_notice" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="privacy_document" validate="true"/>
        <addUniqueConstraint columnNames="privacy_notice_id" constraintName="base_privacy_documents_config_privacy_notice_id_key" tableName="base_privacy_documents_config"/>
        <addForeignKeyConstraint baseColumnNames="privacy_policy_id" baseTableName="base_privacy_documents_config" constraintName="fk_base_privacy_documents_config_privacy_document_privacy_policy" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="privacy_document" validate="true"/>
        <addUniqueConstraint columnNames="privacy_policy_id" constraintName="base_privacy_documents_config_privacy_policy_id_key" tableName="base_privacy_documents_config"/>
    </changeSet>
</databaseChangeLog>
