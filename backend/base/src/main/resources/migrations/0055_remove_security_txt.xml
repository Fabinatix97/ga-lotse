<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="GA-Lotse" id="1744208483198-1">
        <dropForeignKeyConstraint baseTableName="department_configuration" constraintName="fk_department_configuration_security_txt_id_document"/>
        <dropForeignKeyConstraint baseTableName="department_configuration" constraintName="fk_department_configuration_security_txt_public_key_id_document"/>
        <sql>
            DELETE FROM document
            WHERE id IN (
                SELECT security_txt_id
                FROM department_configuration
                WHERE security_txt_id IS NOT NULL
            )
            OR id IN (
                SELECT security_txt_public_key_id
                FROM department_configuration
                WHERE security_txt_public_key_id IS NOT NULL
            );
        </sql>
        <dropUniqueConstraint constraintName="department_configuration_security_txt_id_key" tableName="department_configuration"/>
        <dropUniqueConstraint constraintName="department_configuration_security_txt_public_key_id_key" tableName="department_configuration"/>
        <dropColumn columnName="security_txt_id" tableName="department_configuration"/>
        <dropColumn columnName="security_txt_public_key_id" tableName="department_configuration"/>
    </changeSet>
</databaseChangeLog>
