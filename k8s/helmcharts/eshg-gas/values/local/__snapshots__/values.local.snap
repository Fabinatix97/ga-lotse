# Source: ga-lotse-gas/templates/citizen-portal-auth.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: citizen-portal-auth-cache
  namespace: snapshot-ns
  labels:
    app: citizen-portal-auth-cache
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: citizen-portal-auth-cache-app
  template:
    metadata:
      name: citizen-portal-auth-cache
      labels:
        app: citizen-portal-auth-cache-app
    spec:
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      containers:
      - name: citizen-portal-auth-cache
        image: "docker.io/redis:7.4.4-alpine3.21@sha256:ee9e8748ace004102a267f7b8265dab2c618317df22507b89d16a8add7154273"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        command: ["redis-server"]
        args: ["--requirepass", "$(REDIS_PASSWORD)", "--maxmemory-policy", "allkeys-lru", "--maxmemory", "5M"]
        env:
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              name: citizenportalauth-redis
              key: REDIS_PASSWORD
        resources:
          limits:
            memory: 128Mi
          requests:
            cpu: 10m
        livenessProbe:
          exec:
            command:
            - /usr/bin/sh
            - -c
            - /usr/local/bin/redis-cli -a $REDIS_PASSWORD ping
          initialDelaySeconds: 10
          timeoutSeconds: 5
        volumeMounts:
        - mountPath: /data
          name: data
      volumes:
      - name: data
        emptyDir: {}
---
# Source: ga-lotse-gas/templates/citizen-portal-reverse-proxy.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: citizen-portal-reverse-proxy
  namespace: snapshot-ns
  labels:
    app: citizen-portal-reverse-proxy
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: citizen-portal-reverse-proxy-app
  template:
    metadata:
      name: citizen-portal-reverse-proxy
      labels:
        app: citizen-portal-reverse-proxy-app
      annotations:
        checksum/config: '###DYNAMIC_FIELD###'
        kubectl.kubernetes.io/default-container: application
    spec:
      dnsConfig:
        nameservers:
        - 127.0.0.1
      dnsPolicy: None
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      initContainers:
      - name: waitfor-citizen-portal-auth
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
