              key: citizenportal
        - name: eshg.spatz.actor.host-name
          value: "cp.frankfurt.svc.cluster.local"
        - name: eshg.spatz.actor.type
          value: WEB
        - name: eshg.spatz.actor.readable-name
          value: "citizen-portal-reverse-proxy"
        - name: eshg.spatz.actor.natural-id
          value: "cp.frankfurt.svc.cluster.local"
