          requests:
            cpu: 10m
            memory: 64Mi
        ports:
        - containerPort: 443
          protocol: TCP
          name: proxy-incoming
        volumeMounts:
        - mountPath: /etc/nginx/conf.d/default.conf
          name: config
          subPath: citizen-portal.conf
          readOnly: true
        - mountPath: /etc/nginx/auth_request.conf
          name: config
          subPath: auth_request.conf
          readOnly: true
        - mountPath: /etc/nginx/auth_api_request.conf
          name: config
          subPath: auth_api_request.conf
          readOnly: true
        - mountPath: /etc/nginx/nginx.conf
          name: config
          subPath: nginx.conf
          readOnly: true
        - mountPath: /etc/nginx/forward_headers.conf
          name: config
          subPath: forward_headers.conf
          readOnly: true
        - mountPath: /var/cache/nginx
          subPath: cache
          name: nginx-runtime-data
        - mountPath: /var/run
          subPath: var-run
          name: nginx-runtime-data
        - name: certs
          mountPath: /etc/nginx/ssl/tls.crt
          subPath: tls.crt
          readOnly: true
        - name: certs
          mountPath: /etc/nginx/ssl/tls.key
          subPath: tls.key
          readOnly: true
        - mountPath: /etc/nginx/ssl/dhparam
          name: config
          subPath: dhparam
          readOnly: true
      - name: spatz
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
