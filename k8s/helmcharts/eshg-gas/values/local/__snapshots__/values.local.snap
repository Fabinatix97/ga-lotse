# Source: ga-lotse-gas/templates/modules.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: inspection
  namespace: snapshot-ns
  labels:
    app: inspection
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: inspection-app
  template:
    metadata:
      name: inspection
      labels:
        app: inspection-app
      annotations:
        kubectl.kubernetes.io/default-container: application
    spec:
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      dnsConfig:
        nameservers:
        - 127.0.0.1
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      dnsPolicy: None
      initContainers:
      - name: waitfor-lsd
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( AVAILABLE="$(kubectl -n ${POD_NAMESPACE} get deployments -o jsonpath='{.items[?(@.metadata.name=="lsd")].status.conditions[?(@.type=="Available")].status}')"; [ "$AVAILABLE" == "True" ] ); do echo waiting for lsd; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      - name: waitfor-base
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( AVAILABLE="$(kubectl -n ${POD_NAMESPACE} get deployments -o jsonpath='{.items[?(@.metadata.name=="base")].status.conditions[?(@.type=="Available")].status}')"; [ "$AVAILABLE" == "True" ] ); do echo waiting for base; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      - name: waitfor-inspection-db
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( READY="$(kubectl -n ${POD_NAMESPACE} get statefulsets -o jsonpath='{.items[?(@.metadata.name=="inspection-db")].status.readyReplicas}')"; [ "$READY" -ge "1" ] ); do echo waiting for inspection-db; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      containers:
      - name: application
        image: "k3d-ga-lotse-registry:5050/ga-lotse/inspection:latest"
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        imagePullPolicy: Always
        resources:
          limits:
            memory: 1024Mi
          requests:
            cpu: 10m
            memory: 128Mi
        ports:
        - containerPort: 8081
          protocol: TCP
          name: app-mgmt-port
        env:
        - name: SERVER_ADDRESS
          value: 127.0.0.1
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: de.eshg.auditlog.service-url
          value: "http://auditlog.frankfurt.svc.cluster.local"
        - name: management.server.port
          value: "8081"
        - name: management.metrics.tags.application
          value: "eshg-backend-inspection"
        - name: spring.servlet.multipart.max-file-size
          value: "26214400"
        - name: spring.servlet.multipart.max-request-size
          value: "26214400"
        - name: spring.datasource.url
          value: "jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
        - name: DB_HOST
          valueFrom:
            secretKeyRef:
              name: inspection-db
              key: POSTGRESQL_HOST
        - name: DB_PORT
          valueFrom:
            secretKeyRef:
              name: inspection-db
              key: POSTGRESQL_PORT
        - name: DB_NAME
          valueFrom:
            secretKeyRef:
              name: inspection-db
              key: POSTGRESQL_DB
        - name: spring.datasource.username
          valueFrom:
            secretKeyRef:
              name: inspection-db
              key: POSTGRESQL_USER
        - name: spring.datasource.password
          valueFrom:
            secretKeyRef:
              name: inspection-db
              key: POSTGRESQL_PASSWORD
        - name: de.eshg.centralrepository.serviceUrl
          value: "http://centralrepository.central.svc.cluster.local"
        - name: de.eshg.base.service-url
          value: "http://base.frankfurt.svc.cluster.local"
        - name: eshg.keycloak.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: eshg.keycloak.internal.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: spring.security.oauth2.client.registration.module-client.client-id
          value: system-inspection
        - name: spring.security.oauth2.client.registration.module-client.client-secret
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: inspection-module-client-secret
        - name: eshg.keycloak.test-users-secret-override
          valueFrom:
            secretKeyRef:
              name: keycloak-test-user-secrets
              key: test-users-secret-override
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 90
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 10
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 30
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        lifecycle:
          preStop:
            exec:
              command:
              - sh
              - -c
              - sleep 10
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
      - name: spatz
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        lifecycle:
          postStart:
            exec:
              command:
              - /wait-for-containerstart.sh
        ports:
        - containerPort: 443
          protocol: TCP
          name: spatz-incoming
        imagePullPolicy: Always
        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 10m
            memory: 64Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'true'
        - name: ESHG_SPATZ_SELFSIGNED_SUBJECTLOCATION
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'true'
        - name: ESHG_SPATZ_RELAY_URL
          value: "ws://relay-server.central.svc.cluster.local/signalling"
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_LSD_BASEURL
          value: "http://lsd.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_CLIENT_URL
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: spring.security.oauth2.resourceserver.jwt.issuer-uri
          value: "https://keycloak.frankfurt.svc.cluster.local/realms/eshg-lsd"
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTID
          value: eshg-actor
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTSECRET
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: lsd-client-secret
        - name: ESHG_LSDKEYCLOAK_ACTOR_USER
          value: "inspection.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_ACTOR_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-actor-secrets
              key: inspection
        - name: eshg.spatz.actor.host-name
          value: "inspection.frankfurt.svc.cluster.local"
        - name: eshg.spatz.actor.type
          value: FM
        - name: eshg.spatz.actor.readable-name
          value: "inspection"
        - name: eshg.spatz.actor.natural-id
          value: "inspection.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_1
          value: "lsd.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_2
          value: "relay-server.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_1
          valueFrom:
            secretKeyRef:
              name: inspection-db
              key: POSTGRESQL_HOST
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_2
          value: "nominatim.openstreetmap.org"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_3
