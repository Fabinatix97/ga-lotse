kind: Ingress
apiVersion: networking.k8s.io/v1
metadata:
  name: maildev
  namespace: snapshot-ns
spec:
  tls:
  - hosts:
    - mail.frankfurt.svc.cluster.local
    secretName: "maildev-public-tls"
  rules:
  - host: mail.frankfurt.svc.cluster.local
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: maildev
            port:
              name: web
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: "citizen-portal-public"
  namespace: snapshot-ns
spec:
  commonName: "cp.frankfurt.svc.cluster.local"
  dnsNames:
  - "cp.frankfurt.svc.cluster.local"
  issuerRef:
    kind: ClusterIssuer
    name: "local-ca"
  privateKey:
    algorithm: RSA
    encoding: PKCS1
    size: 2048
  secretName: "citizen-portal-public-tls"
  subject: {}
  usages:
  - server auth
  - client auth
