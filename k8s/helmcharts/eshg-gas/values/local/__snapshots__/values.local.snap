# Source: ga-lotse-gas/templates/citizen-portal-reverse-proxy-config.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: citizen-portal-reverse-proxy-config
  namespace: snapshot-ns
data:
  auth_api_request.conf: |
    include auth_request.conf;

    auth_request_set $resolved_authorization $upstream_http_authorization;

    proxy_set_header Authorization    $resolved_authorization;
    proxy_set_header X-Correlation-ID $request_id;
  auth_request.conf: |
    auth_request /auth;

    proxy_set_header Cookie "";
  citizen-portal.conf: |
    server {
      resolver 127.0.0.1 valid=15s ipv6=off; # force resolving cache to localhost
      listen       443 ssl;
      http2        on;
      server_name  cp.frankfurt.svc.cluster.local;

      if ($host != "cp.frankfurt.svc.cluster.local") {
        return 400;
      }

      # Path to the server certificates
      ssl_certificate /etc/nginx/ssl/tls.crt;
      ssl_certificate_key /etc/nginx/ssl/tls.key;

      ssl_session_cache shared:SSL:1m;
      ssl_session_timeout 5m;
      ssl_session_tickets off;

      # curl https://ssl-config.mozilla.org/ffdhe2048.txt > dhparam
      ssl_dhparam /etc/nginx/ssl/dhparam;

      # https://ssl-config.mozilla.org/#server=nginx&version=1.17.7&config=intermediate&openssl=1.1.1k&guideline=5.7
      # intermediate configuration
      ssl_protocols TLSv1.2 TLSv1.3;
      ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
      ssl_prefer_server_ciphers off;
      ssl_conf_command Ciphersuites  TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384;

      # HSTS (ngx_http_headers_module is required) (63072000 seconds)
      proxy_hide_header Strict-Transport-Security;
      add_header Strict-Transport-Security "max-age=63072000" always;

      proxy_set_header x-eshg-host "";

      # access_log  /proc/self/fd/2  main;

      location = /auth/keycloak {
        include forward_headers.conf;
        set $targetHostName http://citizen-portal-auth.frankfurt.svc.cluster.local/auth/keycloak;
        proxy_pass $targetHostName;
      }

      location ~ /auth/login/keycloak.* {
        include forward_headers.conf;
        set $targetHostName http://citizen-portal-auth.frankfurt.svc.cluster.local/auth/login/keycloak;
        proxy_pass $targetHostName$is_args$args;
        # use only absolute path from upstream redirect location
        # since auth module returns its own internal hostname :/
        proxy_redirect ~^https?://[^/]+(.*)$ $1;
      }

      location = /logout/keycloak {
        set $targetHostName http://citizen-portal-auth.frankfurt.svc.cluster.local/logout/keycloak;
        proxy_pass $targetHostName;
      }

      location = /logout {
        include forward_headers.conf;
        set $targetHostName http://citizen-portal-auth.frankfurt.svc.cluster.local/logout;
        proxy_pass $targetHostName;
      }

      location = /browser-aktualisieren {
        set $targetHostName http://citizen-portal-auth.frankfurt.svc.cluster.local/browser_update_required.html;
        proxy_pass $targetHostName;
      }

      location = /login-error {
        set $targetHostName http://citizen-portal-auth.frankfurt.svc.cluster.local/login_error.html;
        proxy_pass $targetHostName;
      }

      # No authorization required for the Department API
      location /api/base/public/department/ {
        set $targetHostName base.frankfurt.svc.cluster.local;
        # rewrite is needed for dynamic host resolving to work with nginx community version
        # https://stackoverflow.com/questions/33218367/nginx-proxy-pass-remove-path-prefix-resolve-dns
        rewrite ^/api/base/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }

      # No authorization required for the Config API
      location = /api/base/public/config {
        set $targetHostName http://base.frankfurt.svc.cluster.local/public/config;
        proxy_pass $targetHostName;
      }

      # No authorization required for the base feature toggles API
      location = /api/base/feature-toggles {
        set $targetHostName http://base.frankfurt.svc.cluster.local/feature-toggles;
        proxy_pass $targetHostName;
      }

      location /api/base/ {
        set $targetHostName base.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/base/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }
      location /api/inspection/gdpr-validation-tasks/ {
        set $targetHostName inspection.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/inspection/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }
      location /api/school-entry/citizen/public/ {
        set $targetHostName schoolentry.frankfurt.svc.cluster.local;
        rewrite ^/api/school-entry/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }
      location /api/school-entry/citizen/auth/ {
        set $targetHostName schoolentry.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/school-entry/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }
      location /api/school-entry/gdpr-validation-tasks/ {
        set $targetHostName schoolentry.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/school-entry/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }

      # handle disabled backends as 404
      # note: all /api/ routes must appear before this
      location /api/ {
        return 404;
      }

      # See https://cronn-gmbh.atlassian.net/browse/ISSUE-3660
      location = /esu {
        return 301 /einschulungsuntersuchung$is_args$args;
      }

      location = /sti {
        return 301 /sexuelle-gesundheit/sti-beratung$is_args$args;
      }

      location = /sab {
        return 301 /sexuelle-gesundheit/sexarbeit$is_args$args;
      }

      # No authentication for specific pages
      location ~ ^/(|_next/static/.+|einschulungsuntersuchung)$ {
        set $targetHostName citizen-portal.frankfurt.svc.cluster.local;
        proxy_pass http://$targetHostName;
      }

      # No authentication needed for security.txt
      location = /.well-known/security.txt {
        set $targetHostName base.frankfurt.svc.cluster.local;
        proxy_pass http://$targetHostName/public/department/security-txt;
      }
      location = /pgp-key.txt {
        set $targetHostName base.frankfurt.svc.cluster.local;
        proxy_pass http://$targetHostName/public/department/security-txt-public-key;
      }

      # No authentication for static stuff
      location /_next/static/ {
        set $targetHostName citizen-portal.frankfurt.svc.cluster.local;
        proxy_pass http://$targetHostName;
      }

      # Until default auth is turned on protect module routes
      location ~ ^/((en|de)/)?(einschulungsuntersuchung/.+|(?:unternehmen/)?mein-bereich/.+|impfberatung/meine-termine(?:/.+)?|sexuelle-gesundheit/mein-bereich(?:/.+)?|amtsaerztlicherdienst/mein-bereich(?:/.+)?)$ {
        include auth_request.conf;

        auth_request_set $resolved_location $upstream_http_location;
        auth_request_set $auth_cookie $upstream_http_set_cookie;

        error_page 401 = @handle_redirect;

        set $targetHostName citizen-portal.frankfurt.svc.cluster.local;
        proxy_pass http://$targetHostName;
      }
      # Prevent access to frontend playground
      location /playground {
          return 404;
      }

      location / {
        # Default authentication requirement dropped until integration with MyUnternehmensKonto is complete
        # include auth_request.conf;

        # auth_request_set $resolved_location $upstream_http_location;
        # auth_request_set $auth_cookie $upstream_http_set_cookie;

        # error_page 401 = @handle_redirect;

        set $targetHostName http://citizen-portal.frankfurt.svc.cluster.local;
        proxy_pass $targetHostName;
      }

      location @handle_redirect {
        add_header Set-Cookie $auth_cookie;

        # use only absolute path from upstream redirect location
        # since auth module returns its own internal hostname :/
        if ($resolved_location ~ "^https?://[^/]+(.*)") {
          set $resolved_location $1;
        }

        return 302 $resolved_location;
      }

      location = /auth {
        internal;

        include forward_headers.conf;
        set $authTargetHost citizen-portal-auth.frankfurt.svc.cluster.local;
        proxy_pass http://$authTargetHost/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";

        proxy_set_header X-Original-URI     $request_uri;
        proxy_set_header X-Original-Method  $request_method;
        proxy_set_header X-Correlation-ID   $request_id;

        proxy_intercept_errors on;
        error_page 302 = @rewrite_302_to_401;
      }

      # Deny access to hidden files.
      location ~/\.{
          deny all;
      }

      # Unfortunately, Nginx does not allow to return a 302 in an auth_request.
      # So we workaround by temporarily rewriting it to 401
      location @rewrite_302_to_401 {
        return 401;
      }

      # specify a custom error page for all common HTTP errors
      error_page
          400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
          500 501 502 503 504 505 507
          @errors;

      # location block for our custom error page
      location @errors {
          internal;
          default_type "text/html; charset=utf-8";
          return 200 '
                  <!DOCTYPE html>
                  <html lang="en">
                  <head>
                      <meta charset="UTF-8">
                      <meta name="viewport" content="width=device-width, initial-scale=1.0">
                      <title>Error</title>
                      <style>
                          body { font-family: Arial, sans-serif; text-align: center; }
                          .error-container { margin-top: 50px; }
                      </style>
                  </head>
                  <body>
                      <div class="error-container">
                          <h1>Oh-weh! Da ging etwas schief.</h1>
                          <p>Wir haben technische Schwierigkeiten. Bitte versuchen Sie es sp&auml;ter noch einmal.</p>
                      </div>
                      <div class="error-container">
                          <h1>Oops! Something went wrong.</h1>
                          <p>We\'re experiencing technical difficulties. Please try again later.</p>
                      </div>
                  </body>
                  </html>
              ';
      }
    }
  dhparam: |-
    -----BEGIN DH PARAMETERS-----
    MIIBCAKCAQEA//////////+t+FRYortKmq/cViAnPTzx2LnFg84tNpWp4TZBFGQz
    +8yTnc4kmz75fS/jY2MMddj2gbICrsRhetPfHtXV/WVhJDP1H18GbtCFY2VVPe0a
    87VXE15/V8k1mE8McODmi3fipona8+/och3xWKE2rec1MKzKT0g6eXq8CrGCsyT7
    YdEIqUuyyOP7uWrat2DX9GgdT0Kj3jlN9K5W7edjcrsZCwenyO4KbXCeAvzhzffi
    7MA0BM0oNC9hkXL+nOmFg/+OTxIy7vKBg8P+OxtMb61zO7X8vC7CIAXFjvGDfRaD
    ssbzSibBsu/6iGtCOGEoXJf//////////wIBAg==
    -----END DH PARAMETERS-----
  forward_headers.conf: |
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # do not forward unverified header from client
    proxy_set_header Forwarded "";
  nginx.conf: |
    worker_processes  auto;

    error_log  /proc/self/fd/2 debug;
    pid        /var/run/nginx.pid;

    events {
      worker_connections  1024;
    }

    http {
      include       /etc/nginx/mime.types;
      default_type  application/octet-stream;
      limit_req_zone $binary_remote_addr zone=organisations_report:10m rate=5r/m;
      limit_req_zone $binary_remote_addr zone=tm_citizen_procedure:10m rate=1r/m;

      log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
      'status=$status '
      'body_bytes_sent=$body_bytes_sent '
      'http_referer=$http_referer '
      '"$http_user_agent" '
      'http_x_forwarded_for=$http_x_forwarded_for '
      'upstream_addr=$upstream_addr '
      'upstream_status=$upstream_status '
      'request_time=$request_time '
      'upstream_response_time=$upstream_response_time '
      'upstream_connect_time=$upstream_connect_time '
      'upstream_header_time=$upstream_header_time ';

      access_log  /proc/self/fd/2  main;

      sendfile        on;
      #tcp_nopush     on;

      # The default proxy buffer size of 4k/8k is not enough and leeds
      # to an internal server error in Nginx:
      # "upstream sent too big header while reading response header from upstream"
      proxy_buffer_size   128k;
      proxy_buffers   4 256k;
      proxy_busy_buffers_size   256k;

      keepalive_timeout  10;
      send_timeout       10;
      client_header_timeout  60;
      client_body_timeout    60;
      client_header_buffer_size 4k;
      client_max_body_size 26214400;
      server_tokens      off;

      #gzip  on;

      include /etc/nginx/conf.d/*.conf;
    }
---
# Source: ga-lotse-gas/templates/employee-portal-reverse-proxy-config.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: employee-portal-reverse-proxy-config
  namespace: snapshot-ns
data:
  auth_api_request.conf: |
    include auth_request.conf;

    auth_request_set $resolved_authorization $upstream_http_authorization;

    proxy_set_header Authorization    $resolved_authorization;
    proxy_set_header X-Correlation-ID $request_id;
  auth_request.conf: |
    auth_request /auth;

    proxy_set_header Cookie "";
  employee-portal.conf: |
    server {
      resolver 127.0.0.1 valid=15s ipv6=off; # force resolving cache to localhost
      listen       443 ssl;
      http2        on;
      server_name  ep.frankfurt.svc.cluster.local;

      if ($host != "ep.frankfurt.svc.cluster.local") {
        return 400;
      }

      # Path to the server certificates
      ssl_certificate /etc/nginx/ssl/tls.crt;
      ssl_certificate_key /etc/nginx/ssl/tls.key;

      ssl_session_cache shared:SSL:1m;
      ssl_session_timeout 5m;
      ssl_session_tickets off;

      # https://ssl-config.mozilla.org/#server=nginx&version=1.27.4&config=modern&openssl=3&guideline=5.7
      # modern configuration
      ssl_protocols TLSv1.3;
      ssl_prefer_server_ciphers off;
      ssl_conf_command Ciphersuites  TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384;

      # HSTS (ngx_http_headers_module is required) (63072000 seconds)
      proxy_hide_header Strict-Transport-Security;
      add_header Strict-Transport-Security "max-age=63072000" always;

      proxy_set_header x-eshg-host "";

      # access_log  /proc/self/fd/2  main;

      location = /auth/keycloak {
        include forward_headers.conf;
        set $targetHostName http://employee-portal-auth.frankfurt.svc.cluster.local/auth/keycloak;
        proxy_pass $targetHostName;
      }

      location ~ /auth/login/keycloak.* {
        include forward_headers.conf;
        set $targetHostName http://employee-portal-auth.frankfurt.svc.cluster.local/auth/login/keycloak;
        proxy_pass $targetHostName$is_args$args;
        # use only absolute path from upstream redirect location
        # since auth module returns its own internal hostname :/
        proxy_redirect ~^https?://[^/]+(.*)$ $1;
      }

      location = /logout/keycloak {
        set $targetHostName http://employee-portal-auth.frankfurt.svc.cluster.local/logout/keycloak;
        proxy_pass $targetHostName;
      }

      location = /logout {
        include forward_headers.conf;
        set $targetHostName http://employee-portal-auth.frankfurt.svc.cluster.local/logout;
        proxy_pass $targetHostName;
      }

      location = /browser-aktualisieren {
        set $targetHostName http://employee-portal-auth.frankfurt.svc.cluster.local/browser_update_required.html;
        proxy_pass $targetHostName;
      }

      location = /login-error {
        set $targetHostName http://employee-portal-auth.frankfurt.svc.cluster.local/login_error.html;
        proxy_pass $targetHostName;
      }

      location /api/base/ {
        set $targetHostName base.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/base/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }
      location /api/auditlog/ {
        set $targetHostName auditlog.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/auditlog/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }
      location /api/inspection/ {
        set $targetHostName inspection.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/inspection/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }
      location ~ /api/school-entry/import/(citizen|school|past-procedure)-list {
        set $targetHostName schoolentry.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/school-entry/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
        proxy_read_timeout 120;
      }
      location /api/school-entry/ {
        set $targetHostName schoolentry.frankfurt.svc.cluster.local;
        include auth_api_request.conf;
        rewrite ^/api/school-entry/(.*) /$1  break;
        proxy_pass http://$targetHostName$uri$is_args$args;
      }

      # handle disabled backends as 404
      # note: all /api/ routes must appear before this
      location /api/ {
        return 404;
      }

      # No authentication needed for security.txt
      location = /.well-known/security.txt {
        set $targetHostName base.frankfurt.svc.cluster.local;
        proxy_pass http://$targetHostName/public/department/security-txt;
      }
      location = /pgp-key.txt {
        set $targetHostName base.frankfurt.svc.cluster.local;
        proxy_pass http://$targetHostName/public/department/security-txt-public-key;
      }
      # Prevent access to frontend playground
      location /playground {
          return 404;
      }

      location / {
        include auth_request.conf;

        auth_request_set $resolved_location $upstream_http_location;
        auth_request_set $auth_cookie $upstream_http_set_cookie;

        error_page 401 = @handle_redirect;

        set $targetHostName http://employee-portal.frankfurt.svc.cluster.local;
        proxy_pass $targetHostName;
      }

      location @handle_redirect {
        add_header Set-Cookie $auth_cookie;

        # use only absolute path from upstream redirect location
        # since auth module returns its own internal hostname :/
        if ($resolved_location ~ "^https?://[^/]+(.*)") {
          set $resolved_location $1;
        }

        return 302 $resolved_location;
      }

      location = /auth {
        internal;

        include forward_headers.conf;
        set $authTargetHost employee-portal-auth.frankfurt.svc.cluster.local;
        proxy_pass http://$authTargetHost/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";

        proxy_set_header X-Original-URI     $request_uri;
        proxy_set_header X-Original-Method  $request_method;
        proxy_set_header X-Correlation-ID   $request_id;

        proxy_intercept_errors on;
        error_page 302 = @rewrite_302_to_401;
      }

      location = /synapse-auth {
        internal;

        include forward_headers.conf;
        set $authTargetHost employee-portal-auth.frankfurt.svc.cluster.local;
        proxy_pass http://$authTargetHost/synapse;
        proxy_pass_request_body off;

        proxy_set_header Content-Length "";
      }

      # Deny access to hidden files.
      location ~/\.{
          deny all;
      }

      # Unfortunately, Nginx does not allow to return a 302 in an auth_request.
      # So we workaround by temporarily rewriting it to 401
      location @rewrite_302_to_401 {
        return 401;
      }

      # specify a custom error page for all common HTTP errors
      error_page
          400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
          500 501 502 503 504 505 507
          @errors;

      # location block for our custom error page
      location @errors {
          internal;
          default_type "text/html; charset=utf-8";
          return 200 '
                  <!DOCTYPE html>
                  <html lang="en">
                  <head>
                      <meta charset="UTF-8">
                      <meta name="viewport" content="width=device-width, initial-scale=1.0">
                      <title>Error</title>
                      <style>
                          body { font-family: Arial, sans-serif; text-align: center; }
                          .error-container { margin-top: 50px; }
                      </style>
                  </head>
                  <body>
                      <div class="error-container">
                          <h1>Oh-weh! Da ging etwas schief.</h1>
                          <p>Wir haben technische Schwierigkeiten. Bitte versuchen Sie es sp&auml;ter noch einmal.</p>
                      </div>
                      <div class="error-container">
                          <h1>Oops! Something went wrong.</h1>
                          <p>We\'re experiencing technical difficulties. Please try again later.</p>
                      </div>
                  </body>
                  </html>
              ';
      }
    }
  forward_headers.conf: |
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Matrix-Device-Id $http_x_forwarded_matrix_device_id;
    # do not forward unverified header from client
    proxy_set_header Forwarded "";
  nginx.conf: |
    worker_processes  auto;

    error_log  /proc/self/fd/2 debug;
    pid        /var/run/nginx.pid;

    events {
      worker_connections  1024;
    }

    http {
      include       /etc/nginx/mime.types;
      default_type  application/octet-stream;

      log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
      'status=$status '
      'body_bytes_sent=$body_bytes_sent '
      'http_referer=$http_referer '
      '"$http_user_agent" '
      'http_x_forwarded_for=$http_x_forwarded_for '
      'upstream_addr=$upstream_addr '
      'upstream_status=$upstream_status '
      'request_time=$request_time '
      'upstream_response_time=$upstream_response_time '
      'upstream_connect_time=$upstream_connect_time '
      'upstream_header_time=$upstream_header_time ';

      access_log  /proc/self/fd/2  main;

      sendfile        on;
      #tcp_nopush     on;

      # The default proxy buffer size of 4k/8k is not enough and leeds
      # to an internal server error in Nginx:
      # "upstream sent too big header while reading response header from upstream"
      proxy_buffer_size   128k;
      proxy_buffers   4 256k;
      proxy_busy_buffers_size   256k;

      keepalive_timeout  10;
      send_timeout       10;
      client_header_timeout  60;
      client_body_timeout    60;
      client_header_buffer_size 4k;
      client_max_body_size 26214400;
      server_tokens      off;

      #gzip  on;

      include /etc/nginx/conf.d/*.conf;
    }
---
# Source: ga-lotse-gas/templates/keycloak-reverse-proxy-config.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: keycloak-reverse-proxy-config
  namespace: snapshot-ns
data:
  forward_headers.conf: |
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Host $host;
    # do not forward unverified header from client
    proxy_set_header Forwarded "";
  keycloak.conf: |
    server {
      resolver 127.0.0.1 valid=15s ipv6=off; # force resolving cache to localhost
      listen       443 ssl;
      http2        on;
      server_name  keycloak.frankfurt.svc.cluster.local;

      if ($host != "keycloak.frankfurt.svc.cluster.local") {
        return 400;
      }

      proxy_ssl_server_name on;

      # access_log  /proc/self/fd/2  main;

      # Path to the server certificates
      ssl_certificate /etc/nginx/ssl/tls.crt;
      ssl_certificate_key /etc/nginx/ssl/tls.key;

      ssl_session_cache shared:SSL:1m;
      ssl_session_timeout 5m;
      ssl_session_tickets off;

      # https://ssl-config.mozilla.org/#server=nginx&version=1.27.4&config=modern&openssl=3&guideline=5.7
      # modern configuration
      ssl_protocols TLSv1.3;
      ssl_prefer_server_ciphers off;
      ssl_conf_command Ciphersuites  TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384;

      # HSTS (ngx_http_headers_module is required) (63072000 seconds)
      proxy_hide_header Strict-Transport-Security;
      add_header Strict-Transport-Security "max-age=63072000" always;

      location /js/ {
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/;
      }

      location /resources/ {
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/resources/;
      }

      location = /robots.txt {
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/robots.txt;
      }

      location = / {
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/;
      }

      location = /admin/ {
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/admin/;
      }

      location = /admin/serverinfo {
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/admin/serverinfo;
      }

      location /admin/master/console/ {
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/admin/master/console/;
      }

      location /admin/realms/ {
          # Do NOT use a trailing slash here, to proxy_pass the *encoded* url
          # since e.g. role names (incl. special chars like '[' and ']') can be part of the path!
          proxy_pass https://keycloak.frankfurt.svc.cluster.local;
      }

      location /realms/master/ {
          include forward_headers.conf;
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/realms/master/;
      }

      location /realms/citizens/ {
          include forward_headers.conf;
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/realms/citizens/;
      }

      location /realms/eshg/ {
          include forward_headers.conf;
          proxy_pass https://keycloak.frankfurt.svc.cluster.local/realms/eshg/;
      }


     # specify a custom error page for all common HTTP errors
      error_page
          400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
          500 501 502 503 504 505 507
          @errors;

      # location block for our custom error page
      location @errors {
          internal;
          default_type "text/html; charset=utf-8";
          return 200 '
                  <!DOCTYPE html>
                  <html lang="en">
                  <head>
                      <meta charset="UTF-8">
                      <meta name="viewport" content="width=device-width, initial-scale=1.0">
                      <title>Error</title>
                      <style>
                          body { font-family: Arial, sans-serif; text-align: center; }
                          .error-container { margin-top: 50px; }
                      </style>
                  </head>
                  <body>
                      <div class="error-container">
                          <h1>Oh-weh! Da ging etwas schief.</h1>
                          <p>Wir haben technische Schwierigkeiten. Bitte versuchen Sie es sp&auml;ter noch einmal.</p>
                      </div>
                      <div class="error-container">
                          <h1>Oops! Something went wrong.</h1>
                          <p>We\'re experiencing technical difficulties. Please try again later.</p>
                      </div>
                  </body>
                  </html>
              ';
      }
    }
  nginx.conf: |
    worker_processes  auto;

    error_log  /proc/self/fd/2 debug;
    pid        /var/run/nginx.pid;

    events {
      worker_connections  1024;
    }

    http {
      include       /etc/nginx/mime.types;
      default_type  application/octet-stream;

      log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
      'status=$status '
      'body_bytes_sent=$body_bytes_sent '
      'http_referer=$http_referer '
      '"$http_user_agent" '
      'http_x_forwarded_for=$http_x_forwarded_for '
      'upstream_addr=$upstream_addr '
      'upstream_status=$upstream_status '
      'request_time=$request_time '
      'upstream_response_time=$upstream_response_time '
      'upstream_connect_time=$upstream_connect_time '
      'upstream_header_time=$upstream_header_time ';

      access_log  /proc/self/fd/2  main;

      sendfile        on;
      #tcp_nopush     on;

      keepalive_timeout  10;
      send_timeout       10;
      client_header_timeout  60;
      client_body_timeout    60;
      client_header_buffer_size 4k;
      client_max_body_size 1M;
      server_tokens      off;

      #gzip  on;

      include /etc/nginx/conf.d/*.conf;
    }
---
