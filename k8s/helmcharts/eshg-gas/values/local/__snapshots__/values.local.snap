        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 10m
            memory: 64Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'true'
        - name: ESHG_SPATZ_SELFSIGNED_SUBJECTLOCATION
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'true'
        - name: ESHG_SPATZ_RELAY_URL
          value: "ws://relay-server.central.svc.cluster.local/signalling"
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_LSD_BASEURL
          value: "http://lsd.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_CLIENT_URL
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: spring.security.oauth2.resourceserver.jwt.issuer-uri
          value: "https://keycloak.frankfurt.svc.cluster.local/realms/eshg-lsd"
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTID
          value: eshg-actor
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTSECRET
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: lsd-client-secret
        - name: ESHG_LSDKEYCLOAK_ACTOR_USER
          value: "base.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_ACTOR_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-actor-secrets
              key: base
        - name: eshg.spatz.actor.host-name
          value: "base.frankfurt.svc.cluster.local"
        - name: eshg.spatz.actor.type
          value: GM
        - name: eshg.spatz.actor.readable-name
          value: "base"
        - name: eshg.spatz.actor.natural-id
          value: "base.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_1
          value: "lsd.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_2
          value: "relay-server.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_1
          valueFrom:
            secretKeyRef:
              name: base-db
              key: POSTGRESQL_HOST
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_2
          valueFrom:
            secretKeyRef:
              name: smtp-secrets
              key: smtp-host
        volumeMounts:
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
      volumes:
      - name: tmp
        emptyDir: {}
      - name: ca
        configMap:
          name: ca
