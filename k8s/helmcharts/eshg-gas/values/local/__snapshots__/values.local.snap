# Source: ga-lotse-gas/templates/auditlog.yaml
kind: StatefulSet
apiVersion: apps/v1
metadata:
  name: auditlog-db
  labels:
    app: auditlog-db
spec:
  replicas: 1
  serviceName: auditlog-db
  selector:
    matchLabels:
      app: auditlog-db-app
  template:
    metadata:
      name: auditlog-db
      labels:
        app: auditlog-db-app
    spec:
      automountServiceAccountToken: false
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
      initContainers:
      - name: db-init
        image: "docker.io/postgres:15.8@sha256:eb3747f5d0a92195ca486d2f15d9a4ee5e9461b0332fe87fbc59069490a5c659"
        imagePullPolicy: IfNotPresent
        securityContext:
          runAsNonRoot: false
          runAsUser: 0
          runAsGroup: 0
        command:
        - 'sh'
        - '-c'
        - |
          chown -R 10001:10001 /var/lib/postgresql/data
        volumeMounts:
        - name: data
          mountPath: /var/lib/postgresql/data
      containers:
      - name: auditlog-db
        image: "docker.io/postgres:15.8@sha256:eb3747f5d0a92195ca486d2f15d9a4ee5e9461b0332fe87fbc59069490a5c659"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        env:
        - name: POSTGRES_DB
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_DB
        - name: POSTGRES_USER
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_USER
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_PASSWORD
        resources: {}
        livenessProbe:
          failureThreshold: 5
          exec:
            command: ["pg_isready", "-h127.0.0.1", "-U $POSTGRES_USER", "-d $POSTGRES_DB"]
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 10
          initialDelaySeconds: 10
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: run
          mountPath: /var/run
        - name: data
          mountPath: /var/lib/postgresql/data
      volumes:
      - name: tmp
        emptyDir: {}
      - name: run
        emptyDir: {}
      - name: data
        persistentVolumeClaim:
          claimName: auditlog-db
