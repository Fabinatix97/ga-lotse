          valueFrom:
            secretKeyRef:
              name: smtp-secrets
              key: smtp-username
        - name: eshg.keycloak.smtp.password
          valueFrom:
            secretKeyRef:
              name: smtp-secrets
              key: smtp-password
        - name: eshg.keycloak.setup-admin.enabled
          value: "true"
        - name: eshg.keycloak.setup-admin.username
          value: "dummy_setup_admin"
        - name: eshg.keycloak.setup-admin.email
          value: "dummy_setup_admin@maildev.lotse"
        - name: eshg.keycloak.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: eshg.keycloak.internal.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: de.eshg.business-modules.clients.SCHOOL_ENTRY.url
          value: "http://schoolentry.frankfurt.svc.cluster.local"
        - name: de.eshg.business-modules.clients.INSPECTION.url
          value: "http://inspection.frankfurt.svc.cluster.local"
        - name: de.eshg.base.svg-sanitizer-base-url
          value: "http://svgsanitizer.frankfurt.svc.cluster.local"
        - name: eshg.keycloak.test-client.max-number-of-parallel-threads
          value: "2"
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 90
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 10
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 30
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        lifecycle:
          preStop:
            exec:
              command:
              - sh
              - -c
              - sleep 10
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
      - name: spatz
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
