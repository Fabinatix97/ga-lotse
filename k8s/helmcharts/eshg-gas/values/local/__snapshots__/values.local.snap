apiVersion: apps/v1
kind: Deployment
metadata:
  name: maildev
  namespace: snapshot-ns
  labels:
    app: maildev
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: maildev-app
  template:
    metadata:
      name: maildev
      labels:
        app: maildev-app
    spec:
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      containers:
      - name: maildev
        image: "docker.io/maildev/maildev:2.2.1@sha256:180ef51f65eefebb0e7122d8308813c1fd7bff164bc440ce5a3c2feee167a810"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 10m
            memory: 64Mi
        env:
        - name: MAILDEV_WEB_USER
          value: dummy
        - name: MAILDEV_WEB_PASS
          value: ePA2h7F5m4J3KtME
        volumeMounts:
        - name: tmp
          mountPath: /tmp
      volumes:
      - name: tmp
        emptyDir: {}
