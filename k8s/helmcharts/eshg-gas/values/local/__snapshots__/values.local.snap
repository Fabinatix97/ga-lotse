# Source: ga-lotse-gas/templates/keycloak.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: keycloak
  namespace: snapshot-ns
  labels:
    app: keycloak
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: keycloak-app
  template:
    metadata:
      name: keycloak
      labels:
        app: keycloak-app
      annotations:
        kubectl.kubernetes.io/default-container: application
    spec:
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      initContainers:
      - name: copy-keycloak-to-tmpfs
        image: "k3d-ga-lotse-registry:5050/ga-lotse/keycloak:latest"
        imagePullPolicy: Always
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
        command: ["bash", "-c"]
        args:
        - rm -rf /ws/keycloak/ && mkdir -p /ws/keycloak/ && cp -R /opt/keycloak/* /ws/keycloak/
        volumeMounts:
        - name: workspace
          mountPath: /ws
      - name: waitfor-keycloak-db
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( READY="$(kubectl -n ${POD_NAMESPACE} get statefulsets -o jsonpath='{.items[?(@.metadata.name=="keycloak-db")].status.readyReplicas}')"; [ "$READY" -ge "1" ] ); do echo waiting for keycloak-db; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      volumes:
      - name: workspace
        emptyDir: {}
      - name: tmp
        emptyDir: {}
      - name: certs
        secret:
          secretName: "keycloak-private-tls"
          defaultMode: 420
      containers:
      - name: application
        image: "k3d-ga-lotse-registry:5050/ga-lotse/keycloak:latest"
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        livenessProbe:
          httpGet:
            path: /health
            port: 9000
            scheme: HTTPS
          initialDelaySeconds: 30
          timeoutSeconds: 10
          periodSeconds: 10
          successThreshold: 1
          failureThreshold: 5
        readinessProbe:
          httpGet:
            path: /health
            port: 9000
            scheme: HTTPS
          initialDelaySeconds: 30
          timeoutSeconds: 10
          periodSeconds: 10
          successThreshold: 1
          failureThreshold: 5
        resources:
          limits:
            memory: 1500Mi
          requests:
            cpu: 10m
            memory: 256Mi
        env:
        - name: KC_PROXY_HEADERS
          value: xforwarded
        - name: KC_HOSTNAME
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: KC_DB_URL
          value: "jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
        - name: DB_HOST
          valueFrom:
            secretKeyRef:
              name: keycloak-db
              key: POSTGRESQL_HOST
        - name: DB_PORT
          valueFrom:
            secretKeyRef:
              name: keycloak-db
              key: POSTGRESQL_PORT
        - name: DB_NAME
          valueFrom:
            secretKeyRef:
              name: keycloak-db
              key: POSTGRESQL_DB
        - name: KC_DB_USERNAME
          valueFrom:
            secretKeyRef:
              name: keycloak-db
              key: POSTGRESQL_USER
        - name: KC_DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-db
              key: POSTGRESQL_PASSWORD
        - name: KC_HTTPS_CERTIFICATE_FILE
          value: /var/run/certs/tls.crt
        - name: KC_HTTPS_CERTIFICATE_KEY_FILE
          value: /var/run/certs/tls.key
        args:
        - "start"
        - "--optimized"
        ports:
        - containerPort: 443
          protocol: TCP
          name: keycloak
        imagePullPolicy: Always
        volumeMounts:
        - name: workspace
          mountPath: /opt
        - name: tmp
          mountPath: /tmp
        - name: certs
          mountPath: /var/run/certs
          readOnly: true
---
kind: Deployment
apiVersion: apps/v1
metadata:
  name: lsd
  namespace: snapshot-ns
  labels:
    app: lsd
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: lsd-app
  template:
    metadata:
      name: lsd
      labels:
        app: lsd-app
      annotations:
        checksum/config: '###DYNAMIC_FIELD###'
        kubectl.kubernetes.io/default-container: application
    spec:
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      dnsConfig:
        nameservers:
        - 127.0.0.1
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      volumes:
      - name: tmp
        emptyDir: {}
      - name: ca
        configMap:
          name: ca
      - name: certs
        secret:
          secretName: "lsd-public-tls"
          defaultMode: 420
      - name: import-data
        secret:
          secretName: lsd-import
          defaultMode: 420
      dnsPolicy: None
      initContainers:
      - name: waitfor-keycloak
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( AVAILABLE="$(kubectl -n ${POD_NAMESPACE} get deployments -o jsonpath='{.items[?(@.metadata.name=="keycloak")].status.conditions[?(@.type=="Available")].status}')"; [ "$AVAILABLE" == "True" ] ); do echo waiting for keycloak; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      containers:
      - name: application
        image: "k3d-ga-lotse-registry:5050/ga-lotse/local-service-directory:latest"
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 90
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 10
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 30
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 1024Mi
          requests:
            cpu: 10m
            memory: 256Mi
        env:
        - name: SERVER_ADDRESS
          value: 127.0.0.1
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: SPRING_SSL_BUNDLE_PEM_LSD_TRUSTSTORE_LOCATION
          value: /var/run/certs/tls.crt
        - name: SPRING_SSL_BUNDLE_PEM_LSD_KEYSTORE_CERTIFICATE
          value: /var/run/certs/tls.crt
        - name: SPRING_SSL_BUNDLE_PEM_LSD_KEYSTORE_PRIVATEKEY
          value: /var/run/certs/tls.key
        - name: spring.security.oauth2.resourceserver.jwt.issuer-uri
          value: "https://keycloak.frankfurt.svc.cluster.local/realms/eshg-lsd"
        - name: ESHG_LSD_MAXCERTIFICATESPERACTOR
          value: "4"
        - name: ESHG_KEYCLOAK_URL
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: ESHG_KEYCLOAK_INTERNAL_URL
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_INTERNAL_ADMINUSER_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-admin
              key: password
        - name: ESHG_LSDKEYCLOAK_INTERNAL_ADMINCLIENT_CLIENTSECRET
          valueFrom:
            secretKeyRef:
              name: keycloak-admin
              key: lsd-admin-client-secret
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTID
          value: eshg-actor
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTSECRET
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: lsd-client-secret
        - name: ESHG_LSD_ORGUNIT_NAME
          value: "frankfurt"
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_LSD_KEYCLOAK_IMPORTFILE
          value: /var/run/import-data/import.json
        - name: management.server.port
          value: "8081"
        imagePullPolicy: Always
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
        - name: certs
          mountPath: /var/run/certs
          readOnly: true
        - name: import-data
          mountPath: /var/run/import-data
          readOnly: true
      - name: spatz
        lifecycle:
          postStart:
            exec:
              command:
              - /wait-for-containerstart.sh
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 10m
            memory: 64Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: spring.ssl.bundle.pem.certificatevalidation.truststore.certificate
          value: /var/run/certs/tls.crt
        - name: eshg.spatz.inbound.force-client-auth
          value: 'false'
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_SSL_KEYSTORE_CERTIFICATE
          value: /var/run/certs/tls.crt
        - name: ESHG_SPATZ_SSL_KEYSTORE_PRIVATEKEY
          value: /var/run/certs/tls.key
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_1
          value: "lsd.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.frankfurt.svc.cluster.local"
        ports:
        - containerPort: 443
          protocol: TCP
          name: spatz-incoming
        volumeMounts:
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
        - name: certs
          mountPath: /var/run/certs
          readOnly: true
        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
---
