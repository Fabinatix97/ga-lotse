        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      initContainers:
      - name: waitfor-employee-portal-auth
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( AVAILABLE="$(kubectl -n ${POD_NAMESPACE} get deployments -o jsonpath='{.items[?(@.metadata.name=="employee-portal-auth")].status.conditions[?(@.type=="Available")].status}')"; [ "$AVAILABLE" == "True" ] ); do echo waiting for employee-portal-auth; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      containers:
      - name: application
        image: "docker.io/nginx:1.27.4@sha256:9d6b58feebd2dbd3c56ab5853333d627cc6e281011cfd6050fa4bcf2072c9496"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        livenessProbe:
          tcpSocket:
            port: 443
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 10m
            memory: 64Mi
        ports:
        - containerPort: 443
          protocol: TCP
          name: proxy-incoming
        volumeMounts:
        - mountPath: /etc/nginx/conf.d/default.conf
          name: config
          subPath: employee-portal.conf
          readOnly: true
        - mountPath: /etc/nginx/auth_request.conf
          name: config
          subPath: auth_request.conf
          readOnly: true
        - mountPath: /etc/nginx/auth_api_request.conf
          name: config
          subPath: auth_api_request.conf
          readOnly: true
        - mountPath: /etc/nginx/nginx.conf
          name: config
          subPath: nginx.conf
          readOnly: true
        - mountPath: /etc/nginx/forward_headers.conf
          name: config
          subPath: forward_headers.conf
          readOnly: true
        - mountPath: /var/cache/nginx
          subPath: cache
          name: nginx-runtime-data
        - mountPath: /var/run
          subPath: var-run
          name: nginx-runtime-data
        - name: certs
          mountPath: /etc/nginx/ssl/tls.crt
          subPath: tls.crt
          readOnly: true
        - name: certs
          mountPath: /etc/nginx/ssl/tls.key
          subPath: tls.key
          readOnly: true
      - name: spatz
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        lifecycle:
          postStart:
            exec:
              command:
              - /wait-for-containerstart.sh
        imagePullPolicy: Always
        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 10m
            memory: 64Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'true'
        - name: ESHG_SPATZ_SELFSIGNED_SUBJECTLOCATION
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_RELAY_URL
          value: "ws://relay-server.central.svc.cluster.local/signalling"
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_LSD_BASEURL
          value: "http://lsd.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_CLIENT_URL
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: spring.security.oauth2.resourceserver.jwt.issuer-uri
          value: "https://keycloak.frankfurt.svc.cluster.local/realms/eshg-lsd"
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTID
          value: eshg-actor
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTSECRET
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: lsd-client-secret
        - name: ESHG_LSDKEYCLOAK_ACTOR_USER
          value: "ep.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_ACTOR_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-actor-secrets
              key: employeeportal
        - name: eshg.spatz.actor.host-name
          value: "ep.frankfurt.svc.cluster.local"
        - name: eshg.spatz.actor.type
          value: WEB
        - name: eshg.spatz.actor.readable-name
          value: "employee-portal-reverse-proxy"
        - name: eshg.spatz.actor.natural-id
          value: "ep.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "8443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_1
          value: "lsd.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_2
          value: "relay-server.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_3
          value: "employee-portal.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_4
          value: "employee-portal-auth.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.frankfurt.svc.cluster.local"
        volumeMounts:
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
      volumes:
      - name: ca
        configMap:
          name: ca
      - name: config
        configMap:
          name: employee-portal-reverse-proxy-config
      - name: certs
        secret:
          secretName: employee-portal-public-tls
          defaultMode: 420
      - name: nginx-runtime-data
        emptyDir:
          medium: Memory
          sizeLimit: 256Mi
