# Source: ga-lotse-gas/templates/employee-portal-auth.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: employee-portal-auth-cache
  namespace: snapshot-ns
  labels:
    app: employee-portal-auth-cache
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: employee-portal-auth-cache-app
  template:
    metadata:
      name: employee-portal-auth-cache
      labels:
        app: employee-portal-auth-cache-app
    spec:
      automountServiceAccountToken: false
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: employee-portal-auth-cache
        image: "docker.io/redis:7.4.4-alpine3.21@sha256:ee9e8748ace004102a267f7b8265dab2c618317df22507b89d16a8add7154273"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        command: ["redis-server"]
        args: ["--requirepass", "$(REDIS_PASSWORD)", "--maxmemory-policy", "allkeys-lru", "--maxmemory", "5M"]
        env:
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              name: employeeportalauth-redis
              key: REDIS_PASSWORD
        resources:
          limits:
            memory: 128Mi
          requests:
            cpu: 10m
        livenessProbe:
          exec:
            command:
            - /usr/bin/sh
            - -c
            - /usr/local/bin/redis-cli -a $REDIS_PASSWORD ping
          initialDelaySeconds: 10
          timeoutSeconds: 5
        volumeMounts:
        - mountPath: /data
          name: data
      volumes:
      - name: data
        emptyDir: {}
