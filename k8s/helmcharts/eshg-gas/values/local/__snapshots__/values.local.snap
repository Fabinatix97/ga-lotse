          value: "relay-server.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_3
          value: "citizen-portal.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_4
          value: "citizen-portal-auth.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.frankfurt.svc.cluster.local"
