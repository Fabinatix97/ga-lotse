# Source: ga-lotse-gas/templates/citizen-portal-reverse-proxy.yaml
apiVersion: traefik.io/v1alpha1
kind: IngressRouteTCP
metadata:
  name: citizen-portal
  namespace: snapshot-ns
spec:
  entryPoints:
  - websecure
  routes:
  - match: HostSNI(`cp.frankfurt.svc.cluster.local`)
    services:
    - name: citizen-portal-reverse-proxy
      port: proxy-incoming
  tls:
    passthrough: true
