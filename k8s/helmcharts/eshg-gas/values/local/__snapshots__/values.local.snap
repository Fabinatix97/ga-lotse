kind: Service
apiVersion: v1
metadata:
  name: schoolentry
  namespace: snapshot-ns
  labels:
    app.kubernetes.io/name: schoolentry
spec:
  selector:
    app: schoolentry-app
  ports:
  - port: 443
    name: spatz-incoming
    targetPort: spatz-incoming
  - port: 8081
    name: app-mgmt-port
    targetPort: app-mgmt-port
---
# Source: ga-lotse-gas/templates/svg-sanitizer.yaml
kind: Service
apiVersion: v1
metadata:
  name: svgsanitizer
  namespace: snapshot-ns
spec:
  selector:
    app: svgsanitizer-app
  ports:
  - port: 443
    targetPort: spatz-incoming
    name: spatz-incoming
---
# Source: ga-lotse-gas/templates/auditlog.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: auditlog
  namespace: snapshot-ns
  labels:
    app: auditlog
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: auditlog-app
  template:
    metadata:
      name: auditlog
      labels:
        app: auditlog-app
      annotations:
        kubectl.kubernetes.io/default-container: application
    spec:
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      dnsConfig:
        nameservers:
        - 127.0.0.1
      volumes:
      - name: tmp
        emptyDir: {}
      - name: ca
        configMap:
          name: ca
      - name: archive
        persistentVolumeClaim:
          claimName: "auditlog-archive"
      - name: certs
        secret:
          secretName: "lsd-public-tls"
          defaultMode: 420
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      dnsPolicy: None
      initContainers:
      - name: waitfor-lsd
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( AVAILABLE="$(kubectl -n ${POD_NAMESPACE} get deployments -o jsonpath='{.items[?(@.metadata.name=="lsd")].status.conditions[?(@.type=="Available")].status}')"; [ "$AVAILABLE" == "True" ] ); do echo waiting for lsd; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      - name: waitfor-auditlog-db
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( READY="$(kubectl -n ${POD_NAMESPACE} get statefulsets -o jsonpath='{.items[?(@.metadata.name=="auditlog-db")].status.readyReplicas}')"; [ "$READY" -ge "1" ] ); do echo waiting for auditlog-db; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      containers:
      - name: application
        image: "k3d-ga-lotse-registry:5050/ga-lotse/auditlog:latest"
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 90
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 10
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8081
            scheme: HTTP
          initialDelaySeconds: 30
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 1024Mi
          requests:
            cpu: 10m
            memory: 256Mi
        env:
        - name: spring.datasource.url
          value: "jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: DB_HOST
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_HOST
        - name: DB_PORT
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_PORT
        - name: DB_NAME
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_DB
        - name: spring.datasource.username
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_USER
        - name: spring.datasource.password
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_PASSWORD
        - name: eshg.keycloak.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: eshg.keycloak.internal.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: de.eshg.base.service-url
          value: "http://base.frankfurt.svc.cluster.local"
        - name: de.eshg.auditlog.service-url
          value: "http://localhost:8080"
        - name: spring.security.oauth2.client.registration.module-client.client-id
          value: system-auditlog
        - name: spring.security.oauth2.client.registration.module-client.client-secret
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: auditlog-module-client-secret
        - name: de.eshg.auditlog.log-storage-dir
          value: /data/audit-log-archive
        - name: management.server.port
          value: "8081"
        lifecycle:
          preStop:
            exec:
              command:
              - sh
              - -c
              - sleep 10
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: archive
          mountPath: /data/audit-log-archive
        imagePullPolicy: Always
      - name: spatz
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        lifecycle:
          postStart:
            exec:
              command:
              - /wait-for-containerstart.sh
        ports:
        - containerPort: 443
          protocol: TCP
          name: spatz-incoming
        imagePullPolicy: Always
        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 10m
            memory: 64Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'true'
        - name: ESHG_SPATZ_SELFSIGNED_SUBJECTLOCATION
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_RELAY_URL
          value: "ws://relay-server.central.svc.cluster.local/signalling"
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_LSD_BASEURL
          value: "http://lsd.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_CLIENT_URL
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: spring.security.oauth2.resourceserver.jwt.issuer-uri
          value: "https://keycloak.frankfurt.svc.cluster.local/realms/eshg-lsd"
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTID
          value: eshg-actor
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTSECRET
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: lsd-client-secret
        - name: ESHG_LSDKEYCLOAK_ACTOR_USER
          value: "auditlog.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_ACTOR_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-actor-secrets
              key: auditlog
        - name: eshg.spatz.actor.host-name
          value: "auditlog.frankfurt.svc.cluster.local"
        - name: eshg.spatz.actor.type
          value: MISC
        - name: eshg.spatz.actor.readable-name
          value: "auditlog"
        - name: eshg.spatz.actor.natural-id
          value: "auditlog.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_1
          value: "lsd.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_2
          value: "relay-server.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_1
          valueFrom:
            secretKeyRef:
              name: auditlog-db
              key: POSTGRESQL_HOST
        volumeMounts:
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
---
# Source: ga-lotse-gas/templates/citizen-portal-auth.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: citizen-portal-auth
  namespace: snapshot-ns
  labels:
    app: citizen-portal-auth
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: citizen-portal-auth-app
  template:
    metadata:
      name: citizen-portal-auth
      labels:
        app: citizen-portal-auth-app
      annotations:
        kubectl.kubernetes.io/default-container: application
    spec:
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      dnsConfig:
        nameservers:
        - 127.0.0.1
      dnsPolicy: None
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      volumes:
      - name: tmp
        emptyDir: {}
      - name: ca
        configMap:
          name: ca
      - name: redis-certs
        secret:
          secretName: citizenportalauth-redis
          defaultMode: 400
          items:
          - key: ca.crt
            path: ca.crt
      initContainers:
      - name: waitfor-lsd
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( AVAILABLE="$(kubectl -n ${POD_NAMESPACE} get deployments -o jsonpath='{.items[?(@.metadata.name=="lsd")].status.conditions[?(@.type=="Available")].status}')"; [ "$AVAILABLE" == "True" ] ); do echo waiting for lsd; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      - name: waitfor-citizen-portal-auth-cache
        image: "mirror.gcr.io/bitnami/kubectl:1.32.2@sha256:9933302d768bbb344fedae9e6e1e452beaf63ae231f3f328272032455ea9aa1e"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command:
        - "bash"
        - "-c"
        - until ( AVAILABLE="$(kubectl -n ${POD_NAMESPACE} get deployments -o jsonpath='{.items[?(@.metadata.name=="citizen-portal-auth-cache")].status.conditions[?(@.type=="Available")].status}')"; [ "$AVAILABLE" == "True" ] ); do echo waiting for citizen-portal-auth-cache; sleep 1; done
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      containers:
      - name: application
        image: "k3d-ga-lotse-registry:5050/ga-lotse/auth:latest"
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        resources:
          limits:
            memory: 1024Mi
          requests:
            cpu: 10m
            memory: 128Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: spring.profiles.include
          value: citizen-portal
        - name: server.servlet.session.cookie.name
          value: __Host-SESSION
        - name: eshg.keycloak.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: eshg.keycloak.internal.url
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: eshg.reverse-proxy.url
          value: https://cp.frankfurt.svc.cluster.local
        - name: spring.data.redis.host
          valueFrom:
            secretKeyRef:
              name: citizenportalauth-redis
              key: REDIS_HOST
        - name: spring.data.redis.password
          valueFrom:
            secretKeyRef:
              name: citizenportalauth-redis
              key: REDIS_PASSWORD
        - name: spring.security.oauth2.client.registration.keycloak.client-secret
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: citizen-auth-client-secret
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
      - name: spatz
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        lifecycle:
          postStart:
            exec:
              command:
              - /wait-for-containerstart.sh
        ports:
        - containerPort: 443
          protocol: TCP
          name: spatz-incoming
        imagePullPolicy: Always
        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 10m
            memory: 64Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features, health-department-frankfurt"
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'true'
        - name: ESHG_SPATZ_SELFSIGNED_SUBJECTLOCATION
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_RELAY_URL
          value: "ws://relay-server.central.svc.cluster.local/signalling"
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_LSD_BASEURL
          value: "http://lsd.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_CLIENT_URL
          value: "https://keycloak.frankfurt.svc.cluster.local"
        - name: spring.security.oauth2.resourceserver.jwt.issuer-uri
          value: "https://keycloak.frankfurt.svc.cluster.local/realms/eshg-lsd"
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTID
          value: eshg-actor
        - name: ESHG_LSDKEYCLOAK_CLIENT_CLIENTSECRET
          valueFrom:
            secretKeyRef:
              name: keycloak-client-secrets
              key: lsd-client-secret
        - name: ESHG_LSDKEYCLOAK_ACTOR_USER
          value: "citizen-portal-auth.frankfurt.svc.cluster.local"
        - name: ESHG_LSDKEYCLOAK_ACTOR_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-actor-secrets
              key: citizenportalauth
        - name: eshg.spatz.actor.host-name
          value: "citizen-portal-auth.frankfurt.svc.cluster.local"
        - name: eshg.spatz.actor.type
          value: WEB
        - name: eshg.spatz.actor.readable-name
          value: "citizen-portal-auth"
        - name: eshg.spatz.actor.natural-id
          value: "citizen-portal-auth.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_1
          value: "lsd.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_2
          value: "relay-server.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_1
          valueFrom:
            secretKeyRef:
              name: citizenportalauth-redis
              key: REDIS_HOST
        volumeMounts:
        - name: ca
          mountPath: /opt/java/openjdk/lib/security/cacerts
          subPath: cacerts
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
