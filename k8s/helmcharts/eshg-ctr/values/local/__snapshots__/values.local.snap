# Source: ga-lotse-ctr/templates/admin-portal.yaml
kind: Deployment
apiVersion: apps/v1
metadata:
  name: adminportal
  namespace: snapshot-ns
  labels:
    app: adminportal
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: adminportal-app
  template:
    metadata:
      name: adminportal
      labels:
        app: adminportal-app
      annotations:
        checksum/config: '###DYNAMIC_FIELD###'
        checksum/usercerts: '###DYNAMIC_FIELD###'
        kubectl.kubernetes.io/default-container: application
    spec:
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      dnsConfig:
        nameservers:
        - 127.0.0.1
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      dnsPolicy: None
      initContainers:
      - name: waitfor-service-directory
        image: "docker.io/rancher/kubectl:1.33.5@sha256:6f157ad0ff43d31320ab7bf4015271a97466f13c49f03c5108b57b47a312d2c2"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command: ["/bin/kubectl", "rollout", "status", "--timeout=1h", "deployments", "service-directory"]
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      containers:
      - name: application
        image: "k3d-ga-lotse-registry:5050/ga-lotse/admin-portal:latest"
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        env:
        - name: HOSTNAME
          value: 127.0.0.1
        - name: PORT
          value: "3000"
        - name: PUBLIC_ENVIRONMENT_TYPE
          value: "dev"
        - name: PUBLIC_FRONTEND_URL
          value: "https://ap.central.svc.cluster.local"
        - name: PUBLIC_BACKEND_SERVICE_DIRECTORY_URL
          value: "https://ap.central.svc.cluster.local"
        volumeMounts:
        - mountPath: /app/admin-portal/.env
          name: admin-portal-env
          subPath: env
          readOnly: true
        resources:
          limits:
            memory: 192Mi
          requests:
            cpu: 10m
            memory: 64Mi
      - name: proxy
        image: "docker.io/nginx:1.29.0@sha256:776b2e787034135a7614429eee7f07e7421cfe37718b1e89de3b41366ea2335d"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        env:
        - name: PORT
          value: "8443"
        livenessProbe:
          tcpSocket:
            port: 8443
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 10m
            memory: 256Mi
        ports:
        - containerPort: 8443
          protocol: TCP
          name: proxy-incoming
        volumeMounts:
        - mountPath: /etc/nginx/conf.d/default.conf
          name: config
          subPath: admin-portal.conf
          readOnly: true
        - mountPath: /etc/nginx/nginx.conf
          name: config
          subPath: nginx.conf
          readOnly: true
        - mountPath: /var/cache/nginx
          subPath: cache
          name: nginx-runtime-data
        - mountPath: /var/run
          subPath: var-run
          name: nginx-runtime-data
        - name: certs
          mountPath: /etc/nginx/ssl/tls.crt
          subPath: tls.crt
          readOnly: true
        - name: certs
          mountPath: /etc/nginx/ssl/tls.key
          subPath: tls.key
          readOnly: true
        - name: usercerts
          mountPath: /etc/nginx/ssl/truststore.crt
          subPath: truststore.crt
          readOnly: true
      - name: spatz
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        lifecycle:
          postStart:
            exec:
              command:
              - /wait-for-containerstart.sh
        resources:
          limits:
            memory: 384Mi
          requests:
            cpu: 10m
            memory: 256Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features"
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_SSL_KEYSTORE_CERTIFICATE
          value: /var/run/certs/tls.crt
        - name: ESHG_SPATZ_SSL_KEYSTORE_PRIVATEKEY
          value: /var/run/certs/tls.key
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: JAVA_TOOL_OPTIONS
          value: "-Xmx128M -Xss256k -Dreactor.schedulers.reactor.schedulers.defaultBoundedElasticQueueSize=5000"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.central.svc.cluster.local"
        imagePullPolicy: Always
        volumeMounts:
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
        - name: certs
          mountPath: /var/run/certs
          readOnly: true
        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        livenessProbe:
          failureThreshold: 3
          periodSeconds: 10
          successThreshold: 1
          tcpSocket:
            port: 443
          timeoutSeconds: 1
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
      volumes:
      - name: ca
        configMap:
          name: ca
      - name: config
        configMap:
          name: admin-portal-reverse-proxy-config
      - name: certs
        secret:
          secretName: admin-portal-public-tls
          defaultMode: 420
      - name: usercerts
        secret:
          secretName: admin-portal-users-tls
          defaultMode: 420
      - name: admin-portal-env
        configMap:
          name: admin-portal-env
      - name: nginx-runtime-data
        emptyDir:
          medium: Memory
          sizeLimit: 256Mi
