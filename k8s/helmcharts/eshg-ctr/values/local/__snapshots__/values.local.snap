# Source: ga-lotse-ctr/templates/admin-portal-reverse-proxy-config.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: admin-portal-reverse-proxy-config
  namespace: snapshot-ns
data:
  admin-portal.conf: |+
    server {
      resolver     127.0.0.1 valid=15s ipv6=off; # force resolving cache to localhost
      listen       8443 ssl default_server;
      http2        on;
      server_name  ap.central.svc.cluster.local;

      if ($host != "ap.central.svc.cluster.local") {
        return 400;
      }

      # access_log  /proc/self/fd/2  main;

      # path to the server certificates
      ssl_certificate /etc/nginx/ssl/tls.crt;
      ssl_certificate_key /etc/nginx/ssl/tls.key;

      # path to the concatenated client certificates file
      ssl_trusted_certificate /etc/nginx/ssl/truststore.crt;

      # client certificate is mandatory for Admin-Portal!
      ssl_verify_client on;

      # optionally, set the depth of the certificate chain verification, default is 1
      ssl_verify_depth 1;

      ssl_session_cache   shared:SSL:1m;
      ssl_session_timeout 5m;
      ssl_session_tickets off;

      ssl_prefer_server_ciphers off;
      ssl_protocols TLSv1.3;
      ssl_ecdh_curve X25519:prime256v1:secp384r1;
      ssl_conf_command Ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384;

      # set timeouts for reading client request header and body
      client_header_timeout 60s;
      client_body_timeout 60s;

      # avoid buffer overflow
      large_client_header_buffers 4 8k;
      client_header_buffer_size 4k;

      # no disclosure of server info
      server_tokens off;

      # website should not be displayed inside a <frame>, an <iframe> or an <object>
      add_header X-Frame-Options DENY always;

      # protect clients from HTTP interception with STS (cached for 63072000 seconds = 2 years)
      add_header Strict-Transport-Security "max-age=63072000; includeSubdomains" always;

      # avoid MIME type sniffing by saying that the MIME types are deliberately configured
      add_header X-Content-Type-Options nosniff always;

      # sent requests should not include any referrer information
      add_header Referrer-Policy "no-referrer" always;

      # isolates the browsing context exclusively to same-origin documents
      add_header Cross-Origin-Opener-Policy "same-origin" always;

      # disallow cross-origin no-cors requests
      add_header Cross-Origin-Resource-Policy "same-origin" always;

      # specify a custom error page for all common HTTP errors
      error_page
          400 401 402 403 404 405 406 408 409 410 411 412 413 414 415 416 421 429
          500 501 502 503 504 505 507
          @errors;

      # location block for our custom error page
      location @errors {
        internal;
        default_type "text/html; charset=utf-8";
        return 200 '
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Error</title>
                    <style>
                        body { font-family: Arial, sans-serif; text-align: center; }
                        .error-container { margin-top: 50px; }
                    </style>
                </head>
                <body>
                    <div class="error-container">
                        <h1>Oh-weh! Da ging etwas schief.</h1>
                        <p>Wir haben technische Schwierigkeiten. Bitte versuchen Sie es sp&auml;ter noch einmal.</p>
                    </div>
                    <div class="error-container">
                        <h1>Oops! Something went wrong.</h1>
                        <p>We\'re experiencing technical difficulties. Please try again later.</p>
                    </div>
                </body>
                </html>
            ';
      }

      # Deny access to hidden files.
      location ~/\\.{
        deny all;
      }

      location /adminapi/ {

        # only allow valid sec-fetch-site headers
        if ($sec_fetch_site_is_ok = 0) {
          return 403;
        }

        # strict request limit, small burst capacity
        limit_req zone=api_zone burst=5 nodelay;

        client_max_body_size 1m;
        client_body_buffer_size 32k;

        limit_except GET HEAD POST PATCH DELETE PUT OPTIONS {
          deny all;
        }

        # set client certificate header
        proxy_set_header x-eshg-client-cert $ssl_client_escaped_cert;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        set $targetHostName service-directory.central.svc.cluster.local;
        proxy_pass http://$targetHostName;
      }

      location / {
        client_max_body_size 1m;
        client_body_buffer_size 32k;

        limit_except GET OPTIONS {
          deny all;
        }

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_pass http://127.0.0.1:3000;
      }
    }

  nginx.conf: |
    worker_processes  auto;

    error_log  /proc/self/fd/2 debug;
    pid        /var/run/nginx.pid;

    events {
      worker_connections  1024;
    }

    http {
      include       /etc/nginx/mime.types;
      default_type  application/octet-stream;

      log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
      'status=$status '
      'body_bytes_sent=$body_bytes_sent '
      'http_referer=$http_referer '
      '"$http_user_agent" '
      'http_x_forwarded_for=$http_x_forwarded_for '
      'upstream_addr=$upstream_addr '
      'upstream_status=$upstream_status '
      'request_time=$request_time '
      'upstream_response_time=$upstream_response_time '
      'upstream_connect_time=$upstream_connect_time '
      'upstream_header_time=$upstream_header_time ';

      access_log  /proc/self/fd/2  main;

      sendfile        on;
      #tcp_nopush     on;

      proxy_buffer_size         16k;
      proxy_buffers             64 4k;
      proxy_busy_buffers_size   24k; # essentially, proxy_buffer_size + 2 small buffers of 4k

      keepalive_timeout  10;
      send_timeout       10;
      server_tokens      off;

      #gzip  on;

      # define a zone for API requests with strict limits: 10 requests per second per IP
      limit_req_zone $binary_remote_addr zone=api_zone:1m rate=10r/s;

      # check sec-fetch-site
      map $http_sec_fetch_site $sec_fetch_site_is_ok {
       default 0;
       "same-origin" 1;
       "none" 1;
      }

      include /etc/nginx/conf.d/*.conf;
    }
---
