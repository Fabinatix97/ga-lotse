apiVersion: traefik.io/v1alpha1
kind: IngressRouteTCP
metadata:
  name: adminportal
  namespace: snapshot-ns
spec:
  entryPoints:
  - websecure
  routes:
  - match: HostSNI(`ap.central.svc.cluster.local`)
    services:
    - name: adminportal
      port: proxy-incoming
  tls:
    passthrough: true
