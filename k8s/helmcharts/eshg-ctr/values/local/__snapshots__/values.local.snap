            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_USER
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_PASSWORD
        resources: {}
        livenessProbe:
          failureThreshold: 5
          exec:
            command: ["pg_isready", "-h127.0.0.1", "-U $POSTGRES_USER", "-d $POSTGRES_DB"]
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 10
          initialDelaySeconds: 10
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: run
          mountPath: /var/run
        - name: data
          mountPath: /var/lib/postgresql/data
      volumes:
      - name: tmp
        emptyDir: {}
      - name: run
        emptyDir: {}
      - name: data
        persistentVolumeClaim:
          claimName: servicedirectory-db
---
