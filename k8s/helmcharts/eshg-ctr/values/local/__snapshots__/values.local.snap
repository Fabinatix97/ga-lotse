kind: Deployment
apiVersion: apps/v1
metadata:
  name: service-directory
  namespace: snapshot-ns
  labels:
    app: service-directory
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: service-directory-app
  template:
    metadata:
      name: service-directory
      labels:
        app: service-directory-app
      annotations:
        checksum/config: '###DYNAMIC_FIELD###'
        kubectl.kubernetes.io/default-container: application
    spec:
      initContainers:
      - name: waitfor-servicedirectory-db
        image: "docker.io/rancher/kubectl:1.33.5@sha256:6f157ad0ff43d31320ab7bf4015271a97466f13c49f03c5108b57b47a312d2c2"
        imagePullPolicy: IfNotPresent
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
          seLinuxOptions:
            type: container_init_t
        command: ["/bin/kubectl", "rollout", "status", "--timeout=1h", "statefulsets", "servicedirectory-db"]
        resources:
          requests:
            cpu: 10m
            memory: 10Mi
          limits:
            cpu: 50m
            memory: 50Mi
      imagePullSecrets:
      - name: "gitlab-registry-pull-secret"
      dnsConfig:
        nameservers:
        - 127.0.0.1
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seLinuxOptions:
          type: container_t
        seccompProfile:
          type: RuntimeDefault
        sysctls:
        - name: net.ipv4.ip_unprivileged_port_start
          value: "53"
      volumes:
      - name: tmp
        emptyDir: {}
      - name: certs
        secret:
          secretName: "service-directory-public-tls"
          defaultMode: 420
      - name: import-data
        configMap:
          name: service-directory-import
          defaultMode: 420
      - name: ca
        configMap:
          name: ca
      dnsPolicy: None
      containers:
      - name: application
        image: "k3d-ga-lotse-registry:5050/ga-lotse/service-directory:latest"
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        startupProbe:
          failureThreshold: 90
          httpGet:
            path: /actuator/health
            port: 8081
            scheme: HTTP
          periodSeconds: 1
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/liveness
            port: 8081
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 10
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health/readiness
            port: 8081
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 1024Mi
          requests:
            cpu: 10m
            memory: 256Mi
        env:
        - name: SERVER_ADDRESS
          value: 127.0.0.1
        - name: spring.datasource.url
          value: "jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
        - name: DB_HOST
          valueFrom:
            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_HOST
        - name: DB_PORT
          valueFrom:
            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_PORT
        - name: DB_NAME
          valueFrom:
            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_DB
        - name: spring.datasource.username
          valueFrom:
            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_USER
        - name: spring.datasource.password
          valueFrom:
            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_PASSWORD
        - name: eshg.sd.allowed-admin-client-commonnames
          value: ap.central.svc.cluster.local
        - name: eshg.sd.admin-certs
          valueFrom:
            secretKeyRef:
              name: admin-portal-users-tls
              key: truststore.crt
        - name: spring.profiles.active
          value: "dev, preview-features"
        - name: eshg.sd.self.common-name
          value: service-directory.central.svc.cluster.local
        - name: eshg.sd.relay-server.common-name
          value: relay-server.central.svc.cluster.local
        - name: ESHG_SD_MAXCERTIFICATESPERACTOR
          value: "4"
        - name: ESHG_SERVICEDIRECTORY_IMPORTFILE
          value: /var/run/import-data/import.json
        - name: management.server.port
          value: "8081"
        imagePullPolicy: Always
        volumeMounts:
        - name: tmp
          mountPath: /tmp
        - name: import-data
          mountPath: /var/run/import-data
          readOnly: true
      - name: spatz
        resources:
          limits:
            memory: 384Mi
          requests:
            cpu: 10m
            memory: 256Mi
        env:
        - name: spring.profiles.active
          value: "dev, preview-features"
        - name: ESHG_SERVICEDIRECTORY_BASEURL
          value: "http://service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_SELFSIGNED_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_RELAY_ENABLED
          value: 'false'
        - name: ESHG_SPATZ_SSL_KEYSTORE_CERTIFICATE
          value: /var/run/certs/tls.crt
        - name: ESHG_SPATZ_SSL_KEYSTORE_PRIVATEKEY
          value: /var/run/certs/tls.key
        - name: ESHG_SPATZ_INBOUND_HANDLERPORT
          value: "443"
        - name: ESHG_SPATZ_OUTBOUND_TARGETPORT
          value: "443"
        - name: ESHG_SPATZ_DNS_UPSTREAMHOST
          value: "10.43.0.10"
        - name: ESHG_SPATZ_DNS_STATICHOSTS_0
          value: "service-directory.central.svc.cluster.local"
        - name: JAVA_TOOL_OPTIONS
          value: "-Xmx128M -Xss256k -Dreactor.schedulers.reactor.schedulers.defaultBoundedElasticQueueSize=5000"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_0
          value: "keycloak.central.svc.cluster.local"
        - name: ESHG_SPATZ_DNS_FORWARDREQUESTALLOWLIST_1
          valueFrom:
            secretKeyRef:
              name: servicedirectory-db
              key: POSTGRESQL_HOST
        - name: ESHG_SPATZ_INBOUND_CLIENTCNALLOWLIST_0
          value: "service-directory.central.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_CLIENTCNALLOWLIST_1
          value: "ap.central.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_CLIENTCNALLOWLIST_2
          value: "relay-server.central.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_CLIENTCNALLOWLIST_3
          value: "lsd.frankfurt.svc.cluster.local"
        - name: ESHG_SPATZ_INBOUND_CLIENTCNALLOWLIST_4
          value: "lsd.central.svc.cluster.local"
        ports:
        - containerPort: 443
          protocol: TCP
          name: spatz-incoming
        imagePullPolicy: Always
        lifecycle:
          postStart:
            exec:
              command:
              - /wait-for-containerstart.sh
          preStop:
            exec:
              command:
              - sh
              - -c
              - sleep 10
        volumeMounts:
        - name: ca
          mountPath: /etc/ssl/certs/localca.pem
          subPath: ca.crt
        - name: certs
          mountPath: /var/run/certs
          readOnly: true
        image: 'k3d-ga-lotse-registry:5050/ga-lotse/spatz:latest'
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          privileged: false
          readOnlyRootFilesystem: true
        livenessProbe:
          failureThreshold: 3
          periodSeconds: 10
          successThreshold: 1
          tcpSocket:
            port: 443
          timeoutSeconds: 1
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /actuator/health
            port: 8079
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
