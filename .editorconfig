root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 80
trim_trailing_whitespace = true

[**/data/test/**]
insert_final_newline = false
trim_trailing_whitespace = false

[*.java]
ij_java_names_count_to_use_import_on_demand = 999