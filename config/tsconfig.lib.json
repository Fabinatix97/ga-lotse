{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "rootDir": "${configDir}",
    "declarationDir": "${configDir}/build/types"
  },
  "include": ["${configDir}/src/**/*.ts", "${configDir}/src/**/*.tsx"]
}
